diff --git a/src/renderer/svg/pua_glyph.rs b/src/renderer/svg/pua_glyph.rs
index 108d587fc2..8d5db57b4d 100644
--- a/src/renderer/svg/pua_glyph.rs
+++ b/src/renderer/svg/pua_glyph.rs
@@ -132,0 +133,50 @@ impl SvgRenderer {
+impl SvgRenderer {
+    /// 원 face에 없는 Wingdings PUA는 PDF fontdb와 같은 공급 경로에서 Wingdings를
+    /// 찾고, 그 cmap에 원 글리프가 있을 때만 원 글자로 그린다. 없으면 표시 대체를 유지한다.
+    pub(super) fn symbol_program_glyphs(&mut self, text: &str, style: &TextStyle) -> bool {
+        let candidates = text
+            .chars()
+            .filter(|&ch| crate::renderer::pua_glyph::symbol_program_candidate(ch))
+            .filter(|&ch| {
+                !style
+                    .native_pua_metrics
+                    .as_ref()
+                    .is_some_and(|program| program.advance_em(ch).is_some())
+            })
+            .collect::<Vec<_>>();
+        if candidates.is_empty() {
+            return false;
+        }
+        let family = crate::renderer::pua_glyph::SYMBOL_PROGRAM;
+        #[cfg(not(all(target_arch = "wasm32", target_os = "unknown")))]
+        if !self.source_font_coverage.has_symbol_program_record(family) {
+            let plan = super::plan_svg_font_file_lookup_with_fallback(
+                family,
+                &self.font_paths,
+                false,
+                false,
+            );
+            let bytes = super::find_font_file(&plan)
+                .filter(|file| file.metadata().is_ok_and(|m| m.len() <= 32 * 1024 * 1024))
+                .and_then(|file| std::fs::read(file).ok());
+            self.source_font_coverage
+                .register_symbol_program(family, bytes.as_deref().map(|bytes| (bytes, 0)));
+        }
+        let covered = candidates
+            .iter()
+            .filter(|&&ch| self.source_font_coverage.symbol_program(ch).is_some())
+            .copied()
+            .collect::<Vec<_>>();
+        if covered.is_empty() {
+            return false;
+        }
+        if self.font_embed_mode != super::FontEmbedMode::None {
+            self.font_codepoints
+                .entry(family.to_owned())
+                .or_default()
+                .extend(covered);
+        }
+        true
+    }
+}
+
diff --git a/src/renderer/svg/tests.rs b/src/renderer/svg/tests.rs
index f0118ee11a..1126265dcb 100644
--- a/src/renderer/svg/tests.rs
+++ b/src/renderer/svg/tests.rs
@@ -1497,0 +1498,38 @@ fn test_svg_hidden_middle_dot_text_uses_run_font_family() {
+
+#[test]
+fn wingdings_pua_uses_wingdings_only_when_supplied() {
+    let style = TextStyle {
+        font_size: 13.333,
+        font_family: "맑은 고딕".to_string(),
+        ..Default::default()
+    };
+    let draw = |coverage: crate::renderer::pua_glyph::FontCoverage| {
+        let mut renderer = SvgRenderer::new();
+        renderer.source_font_coverage = coverage;
+        renderer.begin_page(800.0, 600.0);
+        renderer.draw_text("가\u{F0FC}나", 10.0, 20.0, &style);
+        renderer.output().to_string()
+    };
+    let family_of = |output: &str, text: &str| -> Option<String> {
+        let close = output.find(&format!(">{text}</text>"))?;
+        let open = output[..close].rfind("<text")?;
+        let tag = &output[open..close];
+        let at = tag.find(" font-family=\"")? + 14;
+        let end = tag[at..].find('"')?;
+        Some(tag[at..at + end].to_string())
+    };
+
+    let mut supplied = crate::renderer::pua_glyph::FontCoverage::default();
+    supplied.supply_symbol_program_for_test(&['\u{F0FC}']);
+    let output = draw(supplied);
+    assert_eq!(family_of(&output, "\u{F0FC}").as_deref(), Some("&apos;Wingdings&apos;"));
+    assert!(!output.contains('\u{2714}'));
+    assert_ne!(family_of(&output, "가").as_deref(), Some("&apos;Wingdings&apos;"));
+
+    let mut missing = crate::renderer::pua_glyph::FontCoverage::default();
+    missing.register_symbol_program("Wingdings", None);
+    let output = draw(missing);
+    assert!(family_of(&output, "\u{2714}").is_some());
+    assert!(!output.contains('\u{F0FC}'));
+    assert!(!output.contains("Wingdings"));
+}
