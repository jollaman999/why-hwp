diff --git a/src/renderer/pua_glyph.rs b/src/renderer/pua_glyph.rs
index 66c2703259..2b6ac7dc85 100644
--- a/src/renderer/pua_glyph.rs
+++ b/src/renderer/pua_glyph.rs
@@ -23,0 +24,4 @@ const MAX_SOURCE_BYTES: usize = 32 * 1024 * 1024;
+/// 맑은 고딕 등 원 face에 없는 Wingdings PUA를 한컴 2024 Print는 Wingdings로 그린다.
+pub(crate) const SYMBOL_PROGRAM: &str = "Wingdings";
+const SYMBOL_FIRST: u32 = 0xf020;
+const SYMBOL_LAST: u32 = 0xf0ff;
@@ -35,0 +40,48 @@ pub(crate) fn candidate(cluster: &str) -> Option<char> {
+/// 표시 Unicode 대체(`map_pua_bullet_char`)가 있는 Wingdings 기호 영역 글자.
+pub(crate) fn symbol_program_candidate(ch: char) -> bool {
+    (SYMBOL_FIRST..=SYMBOL_LAST).contains(&(ch as u32))
+        && super::layout::map_pua_bullet_char(ch) != ch
+}
+
+/// 기호 글꼴은 Windows Symbol cmap(3,0)만 갖는 경우가 많아 그 표도 본다.
+fn symbol_glyph(face: &ttf_parser::Face<'_>, code: u32) -> Option<ttf_parser::GlyphId> {
+    let cmap = face.tables().cmap?;
+    cmap.subtables
+        .into_iter()
+        .filter(|table| {
+            table.is_unicode()
+                || (table.platform_id == ttf_parser::PlatformId::Windows && table.encoding_id == 0)
+        })
+        .find_map(|table| table.glyph_index(code))
+        .filter(|glyph| glyph.0 != 0 && face.glyph_bounding_box(*glyph).is_some())
+}
+
+fn names_family(face: &ttf_parser::Face<'_>, family: &str) -> bool {
+    face.names().into_iter().any(|name| {
+        name.name_id == ttf_parser::name_id::FAMILY
+            && name
+                .to_string()
+                .is_some_and(|value| value.trim().eq_ignore_ascii_case(family))
+    })
+}
+
+fn symbol_coverage(family: &str, bytes: &[u8], index: u32) -> [u64; 4] {
+    let mut coverage = [0u64; 4];
+    if bytes.len() > MAX_SOURCE_BYTES {
+        return coverage;
+    }
+    let Ok(face) = ttf_parser::Face::parse(bytes, index) else {
+        return coverage;
+    };
+    if !names_family(&face, family) {
+        return coverage;
+    }
+    for code in SYMBOL_FIRST..=SYMBOL_LAST {
+        if symbol_glyph(&face, code).is_some() {
+            let bit = (code - SYMBOL_FIRST) as usize;
+            coverage[bit / 64] |= 1 << (bit % 64);
+        }
+    }
+    coverage
+}
+
