+    symbol_faces: HashMap<String, [u64; 4]>,
@@ -197,0 +251,34 @@ impl FontCoverage {
+    /// 찾지 못한 공급도 빈 표로 기록해 같은 렌더에서 다시 찾지 않는다.
+    pub(crate) fn register_symbol_program(&mut self, family: &str, source: Option<(&[u8], u32)>) {
+        let coverage = source.map_or([0; 4], |(bytes, index)| {
+            symbol_coverage(family, bytes, index)
+        });
+        self.symbol_faces.insert(primary(family), coverage);
+    }
+
+    pub(crate) fn has_symbol_program_record(&self, family: &str) -> bool {
+        self.symbol_faces.contains_key(&primary(family))
+    }
+
+    /// 실제 공급한 기호 글꼴의 cmap에 원 PUA 글리프가 있을 때만 그 family를 고른다.
+    pub(crate) fn symbol_program(&self, ch: char) -> Option<&'static str> {
+        if !symbol_program_candidate(ch) {
+            return None;
+        }
+        let bit = (ch as u32 - SYMBOL_FIRST) as usize;
+        self.symbol_faces
+            .get(&primary(SYMBOL_PROGRAM))
+            .filter(|coverage| coverage[bit / 64] & (1 << (bit % 64)) != 0)
+            .map(|_| SYMBOL_PROGRAM)
+    }
+
+    #[cfg(test)]
+    pub(crate) fn supply_symbol_program_for_test(&mut self, chars: &[char]) {
+        let mut coverage = [0u64; 4];
+        for &ch in chars {
+            let bit = (ch as u32 - SYMBOL_FIRST) as usize;
+            coverage[bit / 64] |= 1 << (bit % 64);
+        }
+        self.symbol_faces.insert(primary(SYMBOL_PROGRAM), coverage);
+    }
+
