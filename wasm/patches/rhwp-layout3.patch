+        coverage.supply_symbol_program_for_test(&['\u{F0FC}']);
+        assert_eq!(coverage.symbol_program('\u{F0FC}'), Some("Wingdings"));
+        assert_eq!(coverage.symbol_program('\u{F09F}'), None);
+        assert_eq!(coverage.symbol_program('\u{2714}'), None);
