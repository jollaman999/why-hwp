+++ b/src/renderer/pdf.rs
@@ -1770,0 +1771,76 @@ fn add_font_fallbacks(svg: &str, options: &PdfExportOptions) -> String {
+/// Hancom equation faces that the PDF font database does not hold.
+#[cfg(not(all(target_arch = "wasm32", target_os = "unknown")))]
+fn missing_hancom_equation_families(fontdb: &usvg::fontdb::Database) -> Vec<&'static str> {
+    [
+        crate::renderer::equation::hancom_glyphs::FONT_FAMILY,
+        "HancomEQN",
+    ]
+    .into_iter()
+    .filter(|family| !font_family_exists(fontdb, family))
+    .collect()
+}
+
+/// Draw the glyph runs of a missing Hancom equation face with the characters
+/// they stand for in the default equation fonts, as the Skia renderer does.
+#[cfg(not(all(target_arch = "wasm32", target_os = "unknown")))]
+fn decode_missing_hancom_equation_glyphs<'a>(
+    svg: &'a str,
+    missing: &[&str],
+) -> std::borrow::Cow<'a, str> {
+    if missing.is_empty() {
+        return std::borrow::Cow::Borrowed(svg);
+    }
+    const CLOSE: &str = "</text>";
+    let mut out = String::with_capacity(svg.len());
+    let mut rest = svg;
+    while let Some(start) = rest.find("<text") {
+        out.push_str(&rest[..start]);
+        rest = &rest[start..];
+        let Some(tag_end) = rest.find('>') else {
+            break;
+        };
+        let tag = &rest[..=tag_end];
+        let after = &rest[tag_end + 1..];
+        let found = missing.iter().find_map(|family| {
+            let attr = format!("font-family=\"{family}\"");
+            tag.contains(&attr).then_some((*family, attr))
+        });
+        let close = after
+            .find(CLOSE)
+            .filter(|&close| !tag.ends_with("/>") && !after[..close].contains('<'));
+        let (Some((family, attr)), Some(close)) = (found, close) else {
+            out.push_str("<text");
+            rest = &rest["<text".len()..];
+            continue;
+        };
+        let mut italic = false;
+        let mut body = String::with_capacity(close);
+        for ch in after[..close].chars() {
+            match crate::renderer::equation::hancom_glyphs::semantic_fallback_glyph(family, ch) {
+                Some((semantic, intrinsic_italic)) => {
+                    italic |= intrinsic_italic;
+                    match semantic {
+                        '&' => body.push_str("&amp;"),
+                        '<' => body.push_str("&lt;"),
+                        '>' => body.push_str("&gt;"),
+                        _ => body.push(semantic),
+                    }
+                }
+                None => body.push(ch),
+            }
+        }
+        let family_attr = crate::renderer::equation::svg_render::DEFAULT_EQUATION_FONT_FAMILY_ATTR;
+        let replacement = if italic {
+            format!("font-style=\"italic\" {family_attr}")
+        } else {
+            family_attr.to_string()
+        };
+        out.push_str(&tag.replacen(&attr, &replacement, 1));
+        out.push_str(&body);
+        out.push_str(CLOSE);
+        rest = &after[close + CLOSE.len()..];
+    }
+    out.push_str(rest);
+    std::borrow::Cow::Owned(out)
+}
+
