diff --git a/src/renderer/float_placement.rs b/src/renderer/float_placement.rs
index 20ffb3b4e..a0be77694 100644
--- a/src/renderer/float_placement.rs
+++ b/src/renderer/float_placement.rs
@@ -4289,0 +4290,68 @@ pub(crate) fn empty_host_float_successor_absorbed_spacing_px(
+/// 글 없는 host 의 문단 기준 자리차지 그림 띠가 host 줄을 흡수하면(`sw=0`) 한/글은 다음 문단의
+/// 첫 줄을 띠 바닥에 놓는다. host 의 뒤 간격과 다음 문단의 앞 간격은 띠 안에서 소비된다
+/// (자리차지 표 띠의 #6761 과 같은 규칙: 첫 줄 top = max(흐름 + 앞 간격, 띠 바닥)).
+/// 근거는 한글 2024 저장 사다리와 그 PDF 다: host vpos 48653 + 그림 14302 = 다음 문단(앞 간격
+/// 200HU) vpos 62955, host vpos 50217 + 그림 16758 = 다음 문단(앞 간격 200HU) vpos 66975 이고
+/// PDF 글줄 기준선도 그 저장 줄과 같다. 배치는 띠 바닥에 앞 간격을 더해 2.67px 아래에 그렸다.
+///
+/// 다음 문단의 저장 첫 줄이 지금 커서(띠 바닥)와 같은 자리를 증언할 때만 앞 간격을 돌려준다.
+/// 저장 줄이 없거나 다른 자리를 가리키면 종전대로 둔다.
+pub(crate) fn empty_host_picture_successor_absorbed_spacing_px(
+    previous_item: Option<&crate::renderer::pagination::PageItem>,
+    paragraphs: &[Paragraph],
+    para_index: usize,
+    spacing_before: f64,
+    stored_layout: bool,
+    flow_from_body_top: f64,
+    dpi: f64,
+) -> f64 {
+    use crate::model::paragraph::{ColumnBreakType, LineSeg};
+    use crate::renderer::pagination::PageItem;
+    if !stored_layout
+        || !spacing_before.is_finite()
+        || spacing_before <= 0.0
+        || !flow_from_body_top.is_finite()
+    {
+        return 0.0;
+    }
+    let Some(PageItem::Shape {
+        para_index: owner,
+        control_index: 0,
+    }) = previous_item
+    else {
+        return 0.0;
+    };
+    if owner.checked_add(1) != Some(para_index) {
+        return 0.0;
+    }
+    let (Some(host), Some(para)) = (paragraphs.get(*owner), paragraphs.get(para_index)) else {
+        return 0.0;
+    };
+    let [Control::Picture(picture)] = host.controls.as_slice() else {
+        return 0.0;
+    };
+    if picture.caption.is_some()
+        || !crate::renderer::empty_host_line_absorbed_by_topbottom_float(host, &picture.common)
+        || host.stored_text_partition_is_dirty()
+        || host.cell_format_vpos_dirty
+        || para.stored_text_partition_is_dirty()
+        || para.cell_format_vpos_dirty
+        || para.column_type != ColumnBreakType::None
+    {
+        return 0.0;
+    }
+    let Some(line) = para
+        .line_segs
+        .first()
+        .filter(|line| line.tag & LineSeg::TAG_IMPLEMENTATION_PROPERTY == 0 && line.vertical_pos > 0)
+    else {
+        return 0.0;
+    };
+    let saved_top = hwpunit_to_px(line.vertical_pos, dpi);
+    if (saved_top - flow_from_body_top).abs() <= 0.5 {
+        spacing_before
+    } else {
+        0.0
+    }
+}
+
@@ -10396,0 +10465,75 @@ mod tests {
+
+    #[test]
+    fn empty_host_picture_band_absorbs_successor_spacing_before_at_stored_line() {
+        use crate::renderer::pagination::PageItem;
+        // 한글 2024 저장 사다리: host vpos 48653 + 그림 14302 = 다음 문단(앞 간격 200HU) vpos 62955.
+        let host = Paragraph {
+            controls: vec![Control::Picture(Box::new(Picture {
+                common: CommonObjAttr {
+                    width: 48190,
+                    height: 14302,
+                    vert_align: VertAlign::Top,
+                    ..base_common()
+                },
+                ..Default::default()
+            }))],
+            line_segs: vec![LineSeg {
+                vertical_pos: 48653,
+                line_height: 1200,
+                segment_width: 0,
+                ..Default::default()
+            }],
+            ..Default::default()
+        };
+        let next = Paragraph {
+            line_segs: vec![LineSeg {
+                vertical_pos: 62955,
+                line_height: 600,
+                line_spacing: 180,
+                segment_width: 48188,
+                ..Default::default()
+            }],
+            ..Default::default()
+        };
+        let paragraphs = vec![host.clone(), next.clone()];
+        let shape = PageItem::Shape {
+            para_index: 0,
+            control_index: 0,
+        };
+        let before = hwpunit_to_px(200, 96.0);
+        let band_bottom = hwpunit_to_px(48653 + 14302, 96.0);
+        let absorbed = |paragraphs: &[Paragraph], item: &PageItem, stored: bool, before: f64, flow: f64| {
+            empty_host_picture_successor_absorbed_spacing_px(
+                Some(item),
+                paragraphs,
+                1,
+                before,
+                stored,
+                flow,
+                96.0,
+            )
+        };
+        assert_eq!(absorbed(&paragraphs, &shape, true, before, band_bottom), before);
+        // 커서가 저장 줄과 다른 자리면 앞 간격을 그대로 둔다.
+        assert_eq!(absorbed(&paragraphs, &shape, true, before, band_bottom + 1.0), 0.0);
+        assert_eq!(absorbed(&paragraphs, &shape, true, before, band_bottom - before), 0.0);
+        assert_eq!(absorbed(&paragraphs, &shape, false, before, band_bottom), 0.0);
+        assert_eq!(absorbed(&paragraphs, &shape, true, 0.0, band_bottom), 0.0);
+        let paragraph_item = PageItem::FullParagraph { para_index: 0 };
+        assert_eq!(absorbed(&paragraphs, &paragraph_item, true, before, band_bottom), 0.0);
+        // host 줄이 띠에 흡수되지 않았으면(`sw > 0`) 이 규칙의 대상이 아니다.
+        let mut own_line = host.clone();
+        own_line.line_segs[0].segment_width = 48188;
+        assert_eq!(
+            absorbed(&[own_line, next.clone()], &shape, true, before, band_bottom),
+            0.0
+        );
+        let mut treat_as_char = host;
+        if let Control::Picture(picture) = &mut treat_as_char.controls[0] {
+            picture.common.treat_as_char = true;
+        }
+        assert_eq!(
+            absorbed(&[treat_as_char, next], &shape, true, before, band_bottom),
+            0.0
+        );
+    }
