+    #[test]
+    fn hanyang_junggothic_hft_curly_quotes_use_program_advance() {
+        let m = EmbeddedTextMeasurer;
+        let advance = |c: char| {
+            let style = TextStyle {
+                font_family: "한양중고딕".to_string(),
+                font_size: 20.0,
+                ratio: 1.0,
+                source_font_is_hft: true,
+                original_glyph_metric_family: Some(std::sync::Arc::new("한양중고딕".to_string())),
+                ..Default::default()
+            };
+            let positions = m.compute_char_positions(&format!("가{c}나"), &style);
+            positions[2] - positions[1]
+        };
+        // 한컴 2024 Print의 한양중고딕 Type3 /Widths: 큰따옴표 375, 작은따옴표 225.
+        for c in ['\u{201C}', '\u{201D}'] {
+            let width = advance(c);
+            assert!(
+                (width - 0.375 * 20.0).abs() < 0.03,
+                "U+{:04X} {width}",
+                c as u32
+            );
+        }
+        for c in ['\u{2018}', '\u{2019}'] {
+            let width = advance(c);
+            assert!(
+                (width - 0.225 * 20.0).abs() < 0.03,
+                "U+{:04X} {width}",
+                c as u32
+            );
+        }
+    }
