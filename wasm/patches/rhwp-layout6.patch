+// 원본 HFT SHA-256: 067cf9d952613a01de01290080016b1b8ffecb7c077e430d0f8c3aa2a71f0dd0.
+// 표시 대체 글꼴의 전각을 반으로 누른0.5em으로 재면 따옴표마다 뒤 글자가0.125em 밀린다.
@@ -251,2 +257,8 @@ pub(crate) fn declared_original_glyph_advance_em(
