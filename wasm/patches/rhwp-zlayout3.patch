+
+fn centers_in_fullwidth_cell(cluster: &str, style: &TextStyle) -> bool {
+    let mut chars = cluster.chars();
+    let (Some(c), None) = (chars.next(), chars.next()) else {
+        return false;
+    };
+    style.source_font_is_hft
+        && matches!(c, '\u{2013}' | '\u{2020}' | '\u{203B}')
+        && super::layout::char_width_decision(&[c], &[1], 0, style, true).width_source
+            == "heuristicFullwidth"
diff --git a/src/renderer/svg/tests.rs b/src/renderer/svg/tests.rs
--- a/src/renderer/svg/tests.rs
+++ b/src/renderer/svg/tests.rs
@@ -1600,0 +1601,38 @@
+
+#[test]
+fn hft_fullwidth_symbol_is_centred_in_its_cell() {
+    let style = |source_font_is_hft: bool| TextStyle {
+        font_size: 20.0,
+        font_family: "한양신명조".to_string(),
+        source_font_is_hft,
+        ..Default::default()
+    };
+    let dash = |style: &TextStyle| -> (f64, bool) {
+        let mut renderer = SvgRenderer::new();
+        renderer.begin_page(800.0, 600.0);
+        renderer.draw_text("가\u{2013}나", 10.0, 20.0, style);
+        let output = renderer.output();
+        let close = output.find(">\u{2013}</text>").expect("dash text");
+        let tag = &output[output[..close].rfind("<text").unwrap()..close];
+        let at = tag.find(" x=\"").expect("x") + 4;
+        let x: f64 = tag[at..at + tag[at..].find('"').unwrap()].parse().unwrap();
+        (x, tag.contains(" text-anchor=\"middle\""))
+    };
+    let cell = |style: &TextStyle| -> (f64, f64) {
+        let positions = crate::renderer::layout::compute_char_positions("가\u{2013}나", style);
+        (10.0 + positions[1], positions[2] - positions[1])
+    };
+
+    let hft = style(true);
+    let (origin, width) = cell(&hft);
+    assert!((width - 20.0).abs() < 0.01, "{width}");
+    let (x, centred) = dash(&hft);
+    assert!(centred);
+    assert!((x - (origin + width / 2.0)).abs() < 0.001, "{x} {origin} {width}");
+
+    let plain = style(false);
+    let (origin, _) = cell(&plain);
+    let (x, centred) = dash(&plain);
+    assert!(!centred);
+    assert!((x - origin).abs() < 0.001, "{x} {origin}");
+}
