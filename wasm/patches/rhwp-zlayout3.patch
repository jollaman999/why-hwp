@@ -4497,0 +4519,18 @@ fn color_to_svg(color: u32) -> String {
+fn centers_in_fullwidth_cell(cluster: &str, style: &TextStyle) -> bool {
+    let mut chars = cluster.chars();
+    let (Some(c), None) = (chars.next(), chars.next()) else {
+        return false;
+    };
+    if !style.source_font_is_hft || !matches!(c, '\u{2013}' | '\u{2020}' | '\u{203B}') {
+        return false;
+    }
+    // The cell is a full em whether it comes from the fallback rule or from the
+    // HFT program's own width table (rhwp 0.9.1 lists 한양중고딕's ※ at 1000/1000).
+    let decision = super::layout::char_width_decision(&[c], &[1], 0, style, true);
+    match decision.width_source {
+        "heuristicFullwidth" => true,
+        "embeddedMetric" => (decision.base_width_px - style.font_size).abs() < 1e-6,
+        _ => false,
+    }
+}
