diff --git a/src/renderer/layout/text_measurement.rs b/src/renderer/layout/text_measurement.rs
index 8291e917c6..8b22e3817c 100644
--- a/src/renderer/layout/text_measurement.rs
+++ b/src/renderer/layout/text_measurement.rs
@@ -4375,0 +4376,31 @@ mod tests {
+    #[test]
+    fn hanyang_junggothic_hft_bold_curly_quotes_use_program_advance() {
+        let m = EmbeddedTextMeasurer;
+        let advance = |c: char| {
+            let style = TextStyle {
+                font_family: "한양중고딕".to_string(),
+                font_size: 20.0,
+                ratio: 1.0,
+                bold: true,
+                source_font_is_hft: true,
+                original_glyph_metric_family: Some(std::sync::Arc::new("한양중고딕".to_string())),
+                ..Default::default()
+            };
+            let positions = m.compute_char_positions(&format!("가{c}나"), &style);
+            positions[2] - positions[1]
+        };
+        for (c, em) in [
+            ('\u{201C}', 0.375),
+            ('\u{201D}', 0.375),
+            ('\u{2018}', 0.225),
+            ('\u{2019}', 0.225),
+        ] {
+            let width = advance(c);
+            assert!(
+                (width - (em + 0.05) * 20.0).abs() < 0.03,
+                "U+{:04X} {width}",
+                c as u32
+            );
+        }
+    }
