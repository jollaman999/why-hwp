@@ -681,0 +703,70 @@ impl Paragraph {
+    /// why-hwp: HWPX change-tracking marks for the insertion (0x10) and deletion (0x11)
+    /// range tags. The low 24 bits of the tag are the one-based `TcId`; `next_id`
+    /// numbers the ranges (`Id`) in range-tag order across the document.
+    ///
+    /// Matched against HWPX that Hancom Office wrote from the same HWP files (rhwp
+    /// sample issue5169, 510 ranges, and a public 80-range document): `paraend="1"`
+    /// only when the range is the paragraph's one change range and takes the
+    /// paragraph break. A range that takes the break among other change ranges is
+    /// written `paraend="0"`. At one position closing marks come first, then opening
+    /// marks in range-tag order; an empty range closes after it opens.
+    pub(crate) fn track_change_marks(&self, next_id: &mut u32) -> Vec<MarkpenMark> {
+        let ranges: Vec<&RangeTag> = self
+            .range_tags
+            .iter()
+            .filter(|r| matches!(r.tag >> 24, 0x10 | 0x11) && r.start <= r.end)
+            .collect();
+        let takes_break = ranges.len() == 1 && ranges[0].end == self.char_count;
+        let mut marks: Vec<(u32, u8, MarkpenMark)> = Vec::with_capacity(ranges.len() * 2);
+        for range in ranges {
+            *next_id += 1;
+            let track = TrackMark {
+                delete: range.tag >> 24 == 0x11,
+                begin: true,
+                id: *next_id,
+                tc_id: range.tag & 0x00ff_ffff,
+                para_end: false,
+            };
+            let mark = |pos: u32, track: TrackMark| MarkpenMark {
+                char_idx: self.char_offsets.partition_point(|&offset| offset < pos),
+                color: None,
+                utf16_pos: Some(pos),
+                track: Some(track),
+            };
+            let end = TrackMark {
+                begin: false,
+                para_end: takes_break,
+                ..track
+            };
+            let end_rank = if range.start == range.end { 2 } else { 0 };
+            marks.push((range.start, 1, mark(range.start, track)));
+            marks.push((range.end, end_rank, mark(range.end, end)));
+        }
+        marks.sort_by_key(|(pos, rank, _)| (*pos, *rank));
+        marks.into_iter().map(|(_, _, mark)| mark).collect()
+    }
+
+    /// why-hwp: HWPX `hp:p/@paraTcId`, the `TcId` of the paragraph shape change range
+    /// tag (kind 0x13). Hancom Office writes one per paragraph (113 of 113 in rhwp
+    /// sample issue5169).
+    pub(crate) fn para_shape_change_tc_id(&self) -> Option<u32> {
+        self.range_tags
+            .iter()
+            .find(|r| r.tag >> 24 == 0x13)
+            .map(|r| r.tag & 0x00ff_ffff)
+    }
+
+    /// why-hwp: HWPX `hp:run/@charTcId` for the run of the UTF-16 span `start..end`:
+    /// the `TcId` of the last character shape change range tag (kind 0x12) that
+    /// overlaps it. Hancom Office splits runs at character shapes only, so a run can
+    /// overlap several such ranges and keeps the last (matched against rhwp sample
+    /// issue5169, 79 ranges, 68 runs). An empty span counts as one unit.
+    pub(crate) fn char_shape_change_tc_id(&self, start: u32, end: u32) -> Option<u32> {
+        let end = end.max(start + 1);
+        self.range_tags
+            .iter()
+            .rev()
+            .find(|r| r.tag >> 24 == 0x12 && r.start < end && r.end > start)
+            .map(|r| r.tag & 0x00ff_ffff)
+    }
+
