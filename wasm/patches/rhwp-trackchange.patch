+/// why-hwp: `hh:trackChanges` and `hh:trackChangeAuthors`, the last children of
+/// `hh:refList` in HWPX that Hancom Office writes. `id` is the one-based record
+/// index that `TcId` and `authorID` refer to; a record that could not be read is
+/// left out without renumbering the others.
+fn write_track_changes<W: Write, S: crate::storage::Storage>(
+    w: &mut Writer<W>,
+    doc_info: &DocInfo,
+    storage: &S,
+) -> Result<(), SerializeError>
+where
+    S::Error: std::fmt::Display,
+{
+    use crate::model::document::TrackChangeKind;
+
+    let changes = doc_info.track_changes.iter().flatten().count();
+    if changes > 0 {
+        start_tag_attrs(
+            w,
+            "hh:trackChanges",
+            &[("itemCnt", &xml_value(storage, changes)?)],
+            storage,
+        )?;
+        for (index, change) in doc_info.track_changes.iter().enumerate() {
+            let Some(change) = change else { continue };
+            let date = crate::model::memo_time::track_change_date(change.date);
+            let author = xml_value(storage, change.author_id)?;
+            let hide = xml_value(storage, u8::from(change.hide))?;
+            let id = xml_value(storage, index + 1)?;
+            let shape = match (change.kind, change.shape_id) {
+                (TrackChangeKind::CharShape, Some(shape)) => {
+                    Some(("charshapeID", xml_value(storage, shape)?))
+                }
+                (TrackChangeKind::ParaShape, Some(shape)) => {
+                    Some(("parashapeID", xml_value(storage, shape.saturating_sub(1))?))
+                }
+                _ => None,
+            };
+            let mut attrs: Vec<(&str, &str)> = vec![("type", change.kind.hwpx_name())];
+            if let Some(date) = &date {
+                attrs.push(("date", date));
+            }
+            attrs.extend([("authorID", author.as_str()), ("hide", &hide), ("id", &id)]);
+            if let Some((name, value)) = &shape {
+                attrs.push((name, value));
+            }
+            empty_tag(w, "hh:trackChange", &attrs, storage)?;
+        }
+        end_tag(w, "hh:trackChanges", storage)?;
+    }
+
+    let authors = doc_info.track_change_authors.iter().flatten().count();
+    if authors > 0 {
+        start_tag_attrs(
+            w,
+            "hh:trackChangeAuthors",
+            &[("itemCnt", &xml_value(storage, authors)?)],
+            storage,
+        )?;
+        for (index, author) in doc_info.track_change_authors.iter().enumerate() {
+            let Some(author) = author else { continue };
+            empty_tag(
+                w,
+                "hh:trackChangeAuthor",
+                &[
+                    ("name", &author.name),
+                    ("mark", &xml_value(storage, author.mark)?),
+                    ("id", &xml_value(storage, index + 1)?),
+                ],
+                storage,
+            )?;
+        }
+        end_tag(w, "hh:trackChangeAuthors", storage)?;
+    }
+    Ok(())
+}
