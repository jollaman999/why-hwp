+        char_count: text.chars().count() as u32 + 1,
+        ..Default::default()
+    };
+    let tag = |kind: u32, id: u32, start: u32, end: u32| RangeTag {
+        start,
+        end,
+        tag: kind << 24 | id,
+    };
+    para.range_tags = vec![
+        tag(0x10, 2, 6, 7),
+        tag(0x10, 3, 7, 8),
+        tag(0x10, 3, 9, 12),
+        tag(0x11, 17, 0, 4),
+        tag(0x11, 1, 4, 6),
+        tag(0x11, 17, 6, 15),
+        tag(0x02, 0x00ffff, 0, 3),
