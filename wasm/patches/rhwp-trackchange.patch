+/// why-hwp: kind of a change-tracking entry, as stored in its first `u32`.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, serde::Serialize)]
+pub enum TrackChangeKind {
+    /// 0x10, `type="Insert"`
+    Insert,
+    /// 0x11, `type="Delete"`
+    Delete,
+    /// 0x12, `type="CharShape"`
+    CharShape,
+    /// 0x13, `type="ParaShape"`
+    ParaShape,
+}
+
+impl TrackChangeKind {
+    pub fn from_code(code: u32) -> Option<Self> {
+        match code {
+            0x10 => Some(Self::Insert),
+            0x11 => Some(Self::Delete),
+            0x12 => Some(Self::CharShape),
+            0x13 => Some(Self::ParaShape),
+            _ => None,
+        }
+    }
+
+    pub fn code(self) -> u32 {
+        match self {
+            Self::Insert => 0x10,
+            Self::Delete => 0x11,
+            Self::CharShape => 0x12,
+            Self::ParaShape => 0x13,
+        }
+    }
+
+    /// The HWPX `hh:trackChange/@type` value.
+    pub fn hwpx_name(self) -> &'static str {
+        match self {
+            Self::Insert => "Insert",
+            Self::Delete => "Delete",
+            Self::CharShape => "CharShape",
+            Self::ParaShape => "ParaShape",
+        }
+    }
+}
+
+/// why-hwp: one change-tracking entry (`HWPTAG_TRACK_CHANGE`).
+///
+/// The record is kind(4), date(10), author(2), reserved(2), properties(4), then
+/// hide(4) for text changes, or shape ID(4) and hide(4) for shape changes. Checked
+/// against HWPX that Hancom Office wrote from the same HWP files.
+#[derive(Debug, Clone, PartialEq, Eq, serde::Serialize)]
+pub struct TrackChange {
+    pub kind: TrackChangeKind,
+    /// Year, month, day, hour and minute in the local time of the editing PC.
+    /// HWPX stores the same moment in UTC.
+    pub date: [u16; 5],
+    /// One-based index into `DocInfo::track_change_authors`.
+    pub author_id: u16,
+    pub properties: u32,
+    /// Shape changes: the changed shape. HWPX writes a character shape ID as is and
+    /// a paragraph shape ID one lower (Hancom Office, measured on 62 entries).
+    pub shape_id: Option<u32>,
+    /// Hidden in the current view (`hide="1"`), as a deletion usually is.
+    pub hide: bool,
+}
+
+impl TrackChange {
+    /// Read one `HWPTAG_TRACK_CHANGE` record. `None` for a kind or size this does not know.
+    pub fn from_record(data: &[u8]) -> Option<Self> {
+        let u16_at = |offset: usize| {
+            data.get(offset..offset + 2)
+                .map(|b| u16::from_le_bytes([b[0], b[1]]))
+        };
+        let u32_at = |offset: usize| {
+            data.get(offset..offset + 4)
+                .map(|b| u32::from_le_bytes([b[0], b[1], b[2], b[3]]))
+        };
+        let kind = TrackChangeKind::from_code(u32_at(0)?)?;
+        let mut date = [0u16; 5];
+        for (i, part) in date.iter_mut().enumerate() {
+            *part = u16_at(4 + i * 2)?;
+        }
+        let (shape_id, hide) = match kind {
+            TrackChangeKind::Insert | TrackChangeKind::Delete => (None, u32_at(22)?),
+            TrackChangeKind::CharShape | TrackChangeKind::ParaShape => {
+                (Some(u32_at(22)?), u32_at(26).unwrap_or(0))
+            }
+        };
+        Some(Self {
+            kind,
+            date,
+            author_id: u16_at(14)?,
+            properties: u32_at(18)?,
+            shape_id,
+            hide: hide != 0,
+        })
+    }
+}
+
+/// why-hwp: one change-tracking author (`HWPTAG_TRACK_CHANGE_AUTHOR`).
+///
+/// The record is name length(4), name (UTF-16LE), mark(4) and four more bytes that
+/// Hancom Office leaves uninitialized.
+#[derive(Debug, Clone, PartialEq, Eq, serde::Serialize)]
+pub struct TrackChangeAuthor {
+    pub name: String,
+    /// HWPX `hh:trackChangeAuthor/@mark`.
+    pub mark: u32,
+}
+
+impl TrackChangeAuthor {
+    pub fn from_record(data: &[u8]) -> Option<Self> {
+        let len = u32::from_le_bytes(data.get(..4)?.try_into().ok()?) as usize;
+        let name_end = len.checked_mul(2)?.checked_add(4)?;
+        let units: Vec<u16> = data
+            .get(4..name_end)?
+            .chunks_exact(2)
+            .map(|b| u16::from_le_bytes([b[0], b[1]]))
+            .collect();
+        let mark = data
+            .get(name_end..name_end + 4)
+            .map(|b| u32::from_le_bytes([b[0], b[1], b[2], b[3]]))
+            .unwrap_or(0);
+        Some(Self {
+            name: String::from_utf16_lossy(&units),
+            mark,
+        })
+    }
+}
+
