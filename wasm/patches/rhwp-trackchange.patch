+            let t = m.track.unwrap();
+            let name = match (t.delete, t.begin) {
+                (false, true) => "insertBegin",
+                (false, false) => "insertEnd",
+                (true, true) => "deleteBegin",
+                (true, false) => "deleteEnd",
