+// Office wrote for their runs (runs split at character shapes 0, 62, 122 and at 0).
+#[test]
+fn shape_change_tc_ids_follow_hancom_hwpx() {
+    let tag = |kind: u32, id: u32, start: u32, end: u32| RangeTag {
+        start,
+        end,
+        tag: kind << 24 | id,
+    };
+    let para = Paragraph {
+        char_count: 123,
+        range_tags: vec![
+            tag(0x10, 22, 0, 76),
+            tag(0x12, 39, 0, 62),
+            tag(0x12, 70, 62, 92),
+            tag(0x12, 71, 92, 117),
+            tag(0x12, 70, 117, 122),
+            tag(0x12, 73, 122, 123),
+            tag(0x13, 155, 0, 123),
+        ],
+        ..Default::default()
+    };
+    assert_eq!(para.para_shape_change_tc_id(), Some(155));
+    assert_eq!(
+        [(0, 62), (62, 122), (122, 123)].map(|(s, e)| para.char_shape_change_tc_id(s, e)),
+        [Some(39), Some(70), Some(73)]
+    );
+    // Several ranges in one run: the last one is written ("  o 고위관리..." and
+    // "□ 본 연구는..." of the same sample).
+    let two = Paragraph {
+        char_count: 61,
+        range_tags: vec![tag(0x12, 40, 0, 4), tag(0x12, 88, 4, 61)],
+        ..Default::default()
+    };
+    assert_eq!(two.char_shape_change_tc_id(0, 61), Some(88));
+    let tail = Paragraph {
+        char_count: 199,
+        range_tags: vec![tag(0x12, 34, 30, 129), tag(0x12, 26, 129, 130)],
+        ..Default::default()
+    };
+    assert_eq!(tail.char_shape_change_tc_id(30, 130), Some(26));
+    // A range that starts inside the run still names it; an empty run counts one unit.
+    let tab = Paragraph {
+        char_count: 64,
+        range_tags: vec![tag(0x12, 84, 23, 64)],
+        ..Default::default()
+    };
+    assert_eq!(tab.char_shape_change_tc_id(0, 64), Some(84));
+    assert_eq!(tab.char_shape_change_tc_id(64, 64), None);
+    assert_eq!(tab.char_shape_change_tc_id(30, 30), Some(84));
+    assert_eq!(tab.para_shape_change_tc_id(), None);
+}
