+    // Records from a public sample (rhwp samples/issue5169_viewtext_changetracking.hwp)
+    // and what Hancom Office wrote for them in HWPX.
+    #[test]
+    fn track_change_records_read_like_hancom_hwpx() {
+        let hex = |s: &str| {
+            (0..s.len())
+                .step_by(2)
+                .map(|i| u8::from_str_radix(&s[i..i + 2], 16).unwrap())
+                .collect::<Vec<u8>>()
+        };
+        // type="Delete" date="2017-03-22T06:11:00Z" authorID="1" hide="1" (+09:00 PC)
+        let delete = TrackChange::from_record(&hex(
+            "11000000e107030016000f000b00010000000000000001000000",
+        ))
+        .map(|c| (c.kind, c.date, c.author_id, c.shape_id, c.hide));
+        assert_eq!(
+            delete,
+            Some((TrackChangeKind::Delete, [2017, 3, 22, 15, 11], 1, None, true))
+        );
+        // type="ParaShape" authorID="3" hide="0" parashapeID="48"
+        let para = TrackChange::from_record(&hex(
+            "13000000e20704000f000f002a0003000000040000003100000000000000",
+        ))
+        .unwrap();
+        assert_eq!(
+            (para.kind, para.author_id, para.shape_id, para.hide),
+            (TrackChangeKind::ParaShape, 3, Some(49), false)
+        );
+        // type="CharShape" charshapeID="70"
+        let chars = TrackChange::from_record(&hex(
+            "12000000e107030017001100020001000000040000004600000000000000",
+        ))
+        .unwrap();
+        assert_eq!((chars.kind, chars.shape_id), (TrackChangeKind::CharShape, Some(70)));
+        assert_eq!(TrackChange::from_record(&hex("14000000")), None);
+
+        let author =
+            TrackChangeAuthor::from_record(&hex("040000007500730065007200010000006c8ade13"));
+        assert_eq!(
+            author,
+            Some(TrackChangeAuthor {
+                name: "user".into(),
+                mark: 1
+            })
+        );
+        assert_eq!(TrackChangeAuthor::from_record(&hex("0500000041004200")), None);
+    }
diff --git a/src/model/memo_time.rs b/src/model/memo_time.rs
index b6d36b8d49..592a4941ab 100644
--- a/src/model/memo_time.rs
+++ b/src/model/memo_time.rs
@@ -49,0 +50,38 @@ fn memo_zone() -> chrono::FixedOffset {
+
+/// why-hwp: a change-tracking date in UTC, as HWPX writes it. HWP stores the local
+/// time of the editing PC (year, month, day, hour, minute); Hancom Office converts it
+/// with the time zone of the PC that saves the HWPX, as this does.
+pub(crate) fn track_change_date(date: [u16; 5]) -> Option<String> {
+    track_change_date_in(date, &memo_zone())
+}
+
+fn track_change_date_in<Tz: chrono::TimeZone>(date: [u16; 5], zone: &Tz) -> Option<String> {
+    let [year, month, day, hour, minute] = date;
+    let local = chrono::NaiveDate::from_ymd_opt(year.into(), month.into(), day.into())?
+        .and_hms_opt(hour.into(), minute.into(), 0)?;
+    let moment = zone.from_local_datetime(&local).earliest()?;
+    Some(
+        moment
+            .with_timezone(&Utc)
+            .format("%Y-%m-%dT%H:%M:%SZ")
+            .to_string(),
+    )
+}
+
+#[cfg(test)]
+mod tests {
+    #[test]
+    fn track_change_date_is_written_in_utc() {
+        // Hancom Office on a +09:00 PC: HWP 2017-03-22 15:11 -> date="2017-03-22T06:11:00Z".
+        let seoul = chrono::FixedOffset::east_opt(9 * 3600).unwrap();
+        assert_eq!(
+            super::track_change_date_in([2017, 3, 22, 15, 11], &seoul).as_deref(),
+            Some("2017-03-22T06:11:00Z")
+        );
+        assert_eq!(
+            super::track_change_date_in([2026, 3, 19, 5, 0], &seoul).as_deref(),
+            Some("2026-03-18T20:00:00Z")
+        );
+        assert_eq!(super::track_change_date_in([0, 0, 0, 0, 0], &seoul), None);
+    }
+}
