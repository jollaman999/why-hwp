+#[cfg(not(all(target_arch = "wasm32", target_os = "unknown")))]
+#[derive(Debug, Default)]
+struct PdfFontFamilyChains {
+    by_face: std::collections::HashMap<usvg::fontdb::ID, Vec<String>>,
+}
+
+#[cfg(not(all(target_arch = "wasm32", target_os = "unknown")))]
+impl PdfFontFamilyChains {
+    fn record(&mut self, id: usvg::fontdb::ID, families: &[usvg::FontFamily]) {
+        let names = families
+            .iter()
+            .filter_map(|family| match family {
+                usvg::FontFamily::Named(name) => Some(name.clone()),
+                _ => None,
+            })
+            .collect();
+        self.by_face.insert(id, names);
+    }
+
+    fn select(
+        &self,
+        c: char,
+        used_fonts: &[usvg::fontdb::ID],
+        fontdb: &usvg::fontdb::Database,
+    ) -> Option<usvg::fontdb::ID> {
+        let base_id = *used_fonts.first()?;
+        let base = fontdb.face(base_id)?;
+        self.by_face.get(&base_id)?.iter().find_map(|name| {
+            let id = fontdb.query(&usvg::fontdb::Query {
+                families: &[usvg::fontdb::Family::Name(name)],
+                weight: base.weight,
+                stretch: base.stretch,
+                style: base.style,
+            })?;
+            (!used_fonts.contains(&id) && pdf_font_face_has_char(fontdb, id, c)).then_some(id)
+        })
+    }
+}
+
+/// Font resolver for compatibility PDF conversion: a character missing from the
+/// selected face is looked up in the rest of the SVG `font-family` list first,
+/// then in the whole database ([`pdf_font_fallback_selector_with_limits`]).
+#[cfg(not(all(target_arch = "wasm32", target_os = "unknown")))]
+#[doc(hidden)]
+pub fn pdf_font_resolver_with_limits(
+    max_chars: usize,
+    max_face_slots: usize,
+) -> usvg::FontResolver<'static> {
+    let chains = std::sync::Arc::new(std::sync::Mutex::new(PdfFontFamilyChains::default()));
+    let stock_select = usvg::FontResolver::default_font_selector();
+    let record_chains = chains.clone();
+    let select_font: usvg::FontSelectionFn<'static> = Box::new(move |font, fontdb| {
+        let id = stock_select(font, fontdb)?;
+        if let Ok(mut chains) = record_chains.lock() {
+            chains.record(id, font.families());
+        }
+        Some(id)
+    });
+    let indexed = pdf_font_fallback_selector_with_limits(max_chars, max_face_slots);
+    let select_fallback: usvg::FallbackSelectionFn<'static> =
+        Box::new(move |c, used_fonts, fontdb| {
+            let chained = chains
+                .lock()
+                .ok()
+                .and_then(|chains| chains.select(c, used_fonts, fontdb));
+            chained.or_else(|| indexed(c, used_fonts, fontdb))
+        });
+    usvg::FontResolver {
+        select_font,
+        select_fallback,
+    }
+}
