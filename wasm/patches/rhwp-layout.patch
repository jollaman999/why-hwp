+#[test]
+fn caption_bullet_paragraph_draws_marker_before_body() {
+    use crate::model::style::{Bullet, HeadType};
+    use crate::renderer::style_resolver::{ResolvedCharStyle, ResolvedParaStyle};
+
+    fn text_runs(node: &RenderNode, out: &mut Vec<(String, f64)>) {
+        if let RenderNodeType::TextRun(run) = &node.node_type {
+            out.push((run.text.clone(), node.bbox.x));
+        }
+        for child in &node.children {
+            text_runs(child, out);
+        }
+    }
+
+    let engine = LayoutEngine::with_default_dpi();
+    let mut tree = PageLayoutContext::new(0, 800.0, 1_100.0);
+    let area = LayoutRect {
+        x: 100.0,
+        y: 100.0,
+        width: 600.0,
+        height: 900.0,
+    };
+    let mut column = RenderNode::new(
+        tree.next_id(),
+        RenderNodeType::Column(0),
+        BoundingBox::new(area.x, area.y, area.width, area.height),
+    );
+    let caption = Caption {
+        direction: CaptionDirection::Bottom,
+        paragraphs: vec![Paragraph {
+            text: "상기".to_string(),
+            line_segs: vec![LineSeg {
+                line_height: 1100,
+                text_height: 1100,
+                baseline_distance: 935,
+                segment_width: 45000,
+                ..Default::default()
+            }],
+            ..Default::default()
+        }],
+        ..Default::default()
+    };
+    let styles = ResolvedStyleSet {
+        char_styles: vec![ResolvedCharStyle {
+            font_size: 14.0,
+            ..Default::default()
+        }],
+        para_styles: vec![ResolvedParaStyle {
+            head_type: HeadType::Bullet,
+            numbering_id: 1,
+            ..Default::default()
+        }],
+        bullets: vec![Bullet {
+            bullet_char: '※',
+            text_distance: 50,
+            attr: 1 << 3,
+            char_shape_id: u32::MAX,
+            ..Default::default()
+        }],
+        ..Default::default()
+    };
+
+    engine.layout_caption(
+        &mut tree,
+        &mut column,
+        &caption,
+        &styles,
+        &area,
+        area.x,
+        area.width,
+        area.y,
+        &mut crate::renderer::AutoNumberCounter::default(),
+        &[],
+        None,
+        None,
+    );
+
+    let mut runs = Vec::new();
+    text_runs(&column, &mut runs);
+    let marker_x = runs
+        .iter()
+        .find(|(text, _)| text == "※")
+        .map(|(_, x)| *x)
+        .expect("caption bullet marker run");
+    let body_x = runs
+        .iter()
+        .find(|(text, _)| text.contains("상기"))
+        .map(|(_, x)| *x)
+        .expect("caption body run");
+    assert!((marker_x - area.x).abs() < 0.5, "marker_x={marker_x}");
+    assert!(
+        body_x > marker_x + 14.0,
+        "marker_x={marker_x} body_x={body_x}"
+    );
+}
