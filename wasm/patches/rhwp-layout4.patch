+    )
+}
+
+/// PDF 한 장에 페이지를 놓는 방식.
+#[cfg(not(all(target_arch = "wasm32", target_os = "unknown")))]
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Default)]
+pub enum PdfSheetLayout {
+    /// 한 장에 한 페이지.
+    #[default]
+    OnePage,
+    /// 한 장에 두 페이지 (한글 인쇄 방식 4, 2쪽 모아 찍기).
+    TwoUp,
+}
+
+#[cfg(not(all(target_arch = "wasm32", target_os = "unknown")))]
+impl PdfSheetLayout {
+    /// 문서에 실린 인쇄 방식(`DocInfo::print_method`)이 뜻하는 배치.
+    ///
+    /// 한글 PDF 로 배치를 잰 것은 4(2쪽 모아 찍기)뿐이다. 그 밖의 값은 한 장에 한 페이지로 둔다.
+    pub fn from_print_method(print_method: Option<u32>) -> Self {
+        match print_method {
+            Some(4) => Self::TwoUp,
+            _ => Self::OnePage,
+        }
+    }
+}
+
+/// 장 안에 놓인 페이지 하나. `x`·`y` 는 장 왼쪽 아래에서 잰 페이지 왼쪽 아래 모서리(pt).
+#[cfg(not(all(target_arch = "wasm32", target_os = "unknown")))]
+#[derive(Debug, Clone, Copy, PartialEq)]
+struct PdfSheetSlot {
+    /// 변환된 페이지 목록에서의 순번.
+    page: usize,
+    scale: f32,
+    x: f32,
+    y: f32,
+}
+
+#[cfg(not(all(target_arch = "wasm32", target_os = "unknown")))]
+#[derive(Debug, Clone, PartialEq)]
+struct PdfSheet {
+    width: f32,
+    height: f32,
+    slots: Vec<PdfSheetSlot>,
+}
+
+/// 한글 2024 가 2쪽 모아 찍기에서 A4 세로 페이지를 줄이는 비율.
