+        font_family: "맑은 고딕".to_string(),
+        letter_spacing,
+        ..Default::default()
+    };
+    // (조판 칸의 폭, 숨은 글자의 textLength). 원은 조판 칸의 가운데에 놓이므로
+    // 칸의 폭은 원 중심과 글자 원점 사이의 두 배다.
+    let measure = |style: &TextStyle| -> (f64, f64) {
+        let mut renderer = SvgRenderer::new();
+        renderer.begin_page(800.0, 600.0);
+        renderer.draw_text("가\u{00B7}나", 10.0, 20.0, style);
+        let output = renderer.output();
+        let number = |tag: &str, name: &str| -> f64 {
+            let at = tag.find(&format!(" {name}=\"")).expect(name) + name.len() + 3;
+            let end = tag[at..].find('"').unwrap();
+            tag[at..at + end].parse().unwrap()
+        };
+        let close = output
+            .find(">\u{00B7}</text>")
+            .expect("hidden middle-dot text");
+        let hidden = &output[output[..close].rfind("<text").unwrap()..close];
+        let circle_at = output.find("<circle").expect("vector middle dot");
+        let circle = &output[circle_at..circle_at + output[circle_at..].find("/>").unwrap()];
+        assert!(
+            hidden.contains(" lengthAdjust=\"spacingAndGlyphs\""),
+            "{output}"
+        );
+        assert!(hidden.contains(" fill-opacity=\"0\""), "{output}");
+        (
+            2.0 * (number(circle, "cx") - number(hidden, "x")),
+            number(hidden, "textLength"),
+        )
+    };
+    // 보이는 글자가 textLength 로 받는 폭: 원본 자간을 뺀 글리프 맞춤 경계.
+    let glyph_advance = |style: &TextStyle| -> f64 {
+        let positions = crate::renderer::layout::compute_char_positions("가\u{00B7}나", style);
+        let fit = crate::renderer::glyph_fit_positions("가\u{00B7}나", style, None, &positions);
+        fit[2] - fit[1]
+    };
+
+    let plain = style(0.0);
+    let (cell, fitted) = measure(&plain);
+    assert!(fitted > 1.0);
+    assert!(
+        (fitted - glyph_advance(&plain)).abs() < 0.001,
+        "{fitted} {cell}"
+    );
+
+    // 음수 자간은 조판 칸만 좁힌다. 숨은 글자의 폭은 자간이 없을 때와 같다.
+    let narrow = style(-1.0);
+    let (narrow_cell, narrow_fitted) = measure(&narrow);
+    assert!(narrow_cell < cell - 0.1, "{narrow_cell} {cell}");
+    assert!(
+        (narrow_fitted - glyph_advance(&narrow)).abs() < 0.001,
+        "{narrow_fitted}"
+    );
+    assert!(
+        (narrow_fitted - fitted).abs() < 0.001,
+        "{narrow_fitted} {fitted}"
+    );
+}
+
