--- a/src/renderer/font_paths.rs
+++ b/src/renderer/font_paths.rs
@@ -34,0 +35,22 @@ pub(crate) const MAX_NATIVE_CUSTOM_FONT_BYTES: u64 = 64 * 1024 * 1024;
+/// Skia custom typeface 카탈로그가 메모리에 올리는 글꼴 바이트의 예산.
+///
+/// Skia 없이 빌드한 출력(SVG·PDF)은 이 카탈로그를 만들지 않으므로 예산이 없다.
+pub(crate) fn native_custom_font_budget() -> Option<u64> {
+    cfg!(feature = "native-skia").then_some(MAX_NATIVE_CUSTOM_FONT_BYTES)
+}
+
+/// 공급 글꼴 프로그램 하나가 남은 예산에 드는지 본다. 예산이 없으면 든다.
+pub(crate) fn fits_native_custom_font_budget(
+    budget: Option<u64>,
+    length: u64,
+    used: u64,
+    retained: u64,
+    files: usize,
+) -> bool {
+    budget.is_none_or(|limit| {
+        files < 256
+            && used.saturating_add(length) <= limit
+            && retained.saturating_add(length) <= limit
+    })
+}
+
@@ -320,0 +343,39 @@ mod tests {
+
+    /// Skia 카탈로그 예산은 호출자 글꼴과 공급 글꼴이 나눠 쓴다. 카탈로그가
+    /// 없으면 큰 본문 글꼴이나 호출자 글꼴 폴더 때문에 공급 글꼴을 빼지 않는다.
+    #[test]
+    fn supply_budget_applies_only_with_skia_catalog() {
+        const MB: u64 = 1024 * 1024;
+        assert_eq!(
+            native_custom_font_budget(),
+            cfg!(feature = "native-skia").then_some(64 * MB)
+        );
+
+        let retained = |budget: Option<u64>, host: u64, host_files: usize, supply: &[u64]| {
+            let (mut used, mut files) = (host, host_files);
+            supply
+                .iter()
+                .map(|&length| {
+                    let fits = fits_native_custom_font_budget(budget, length, used, used, files);
+                    if fits {
+                        used += length;
+                        files += 1;
+                    }
+                    fits
+                })
+                .collect::<Vec<_>>()
+        };
+        // 대체 글꼴 셋, 함초롬돋움, 함초롬바탕 순서의 공급 크기.
+        let supply = [8_434_876, 8_439_348, 2_538_340, 22_244_940, 28_413_328];
+        assert_eq!(
+            retained(Some(64 * MB), 0, 0, &supply),
+            [true, true, true, true, false]
+        );
+        assert_eq!(retained(None, 0, 0, &supply), [true; 5]);
+        assert_eq!(
+            retained(Some(64 * MB), 60 * MB, 40, &supply),
+            [false, false, true, false, false]
+        );
+        assert_eq!(retained(Some(64 * MB), 0, 256, &supply), [false; 5]);
+        assert_eq!(retained(None, 60 * MB, 256, &supply), [true; 5]);
+    }
