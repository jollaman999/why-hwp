+/// 링크·책갈피와 함께, 한 장에 페이지를 놓는 방식을 정해 PDF 로 만든다.
+#[cfg(not(all(target_arch = "wasm32", target_os = "unknown")))]
+pub fn svgs_to_pdf_with_annotations_and_layout(
+    svg_pages: &[String],
+    links: &[Vec<super::hyperlinks::PdfLink>],
+    destinations: &[Vec<super::hyperlinks::PdfNamedDestination>],
+    options: &PdfExportOptions,
+    layout: PdfSheetLayout,
+) -> Result<Vec<u8>, String> {
+    svgs_to_pdf_annotations_impl(
+        svg_pages,
+        links,
+        options,
+        svg2pdf_to_chunk,
+        destinations,
