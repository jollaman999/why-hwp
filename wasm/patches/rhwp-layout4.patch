+    #[cfg(not(all(target_arch = "wasm32", target_os = "unknown")))]
+    #[test]
+    fn pdf_export_gathers_two_pages_per_sheet_only_for_print_method_four() {
+        let mut core = DocumentCore::new_empty();
+        core.create_blank_document_native().expect("blank");
+        core.insert_text_native(0, 0, 0, "본문").expect("text");
+        for para in 1..3 {
+            core.insert_paragraph_native(0, para).expect("paragraph");
+            core.insert_page_break_native(0, para, 0)
+                .expect("page break");
+        }
+        assert_eq!(core.page_count(), 3);
+
+        let sheet_sizes = |core: &DocumentCore| -> Vec<(f32, f32)> {
+            let pdf = core.render_document_pdf_native().expect("pdf");
+            let text = String::from_utf8_lossy(&pdf);
+            text.match_indices("/MediaBox [")
+                .map(|(at, key)| {
+                    let rest = &text[at + key.len()..];
+                    let numbers: Vec<f32> = rest[..rest.find(']').unwrap()]
+                        .split_whitespace()
+                        .map(|number| number.parse().unwrap())
+                        .collect();
+                    (numbers[2], numbers[3])
+                })
+                .collect()
+        };
+
+        let one_page = sheet_sizes(&core);
+        assert_eq!(one_page.len(), 3);
+        let (width, height) = one_page[0];
+        assert!(width < height, "{one_page:?}");
+        for print_method in [Some(0), Some(1), Some(3), Some(5)] {
+            core.document_mut().doc_info.print_method = print_method;
+            assert_eq!(sheet_sizes(&core), one_page, "{print_method:?}");
+        }
+
+        core.document_mut().doc_info.print_method = Some(4);
+        assert_eq!(sheet_sizes(&core), vec![(height, width); 2]);
+    }
