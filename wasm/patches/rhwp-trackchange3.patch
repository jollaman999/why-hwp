+fn track_change_counts(doc_info: &DocInfo) -> (u32, u32) {
+    let count = |tag_id: u16| {
+        doc_info
+            .extra_records
+            .iter()
+            .filter(|record| record.tag_id == tag_id)
+            .count()
+    };
+    let raw = (
+        count(tags::HWPTAG_TRACK_CHANGE),
+        count(tags::HWPTAG_TRACK_CHANGE_AUTHOR),
+    );
+    let (changes, authors) = if raw != (0, 0) {
+        raw
+    } else {
+        (
+            doc_info.track_changes.iter().flatten().count(),
+            doc_info.track_change_authors.iter().flatten().count(),
+        )
+    };
+    (changes as u32, authors as u32)
