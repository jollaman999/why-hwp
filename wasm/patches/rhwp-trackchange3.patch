@@ -389,0 +394,83 @@ fn parse_track_change_config(e: &quick_xml::events::BytesStart, doc_info: &mut D
+/// why-hwp: `<hh:trackChange>` into `DocInfo::track_changes` at its one-based `id`,
+/// the index that `TcId` names. The reverse of the HWPX writer in
+/// `serializer/hwpx/header.rs`: `parashapeID` is one lower than the HWP shape ID, and
+/// `properties` is 4 for shape changes and 0 for text changes, as in every record of
+/// the HWP files Hancom Office wrote for rhwp sample issue5169 and the t2 sample.
+fn parse_track_change(e: &quick_xml::events::BytesStart, doc_info: &mut DocInfo) {
+    use crate::model::document::{TrackChange, TrackChangeKind};
+
+    let mut kind = None;
+    let mut date = [0u16; 5];
+    let mut author_id = 0u16;
+    let mut hide = false;
+    let mut id = None;
+    let mut char_shape = None;
+    let mut para_shape = None;
+    for attr in e.attributes().flatten() {
+        match attr.key.as_ref().as_bytes() {
+            b"type" => {
+                kind = match attr_str(&attr).as_str() {
+                    "Insert" => Some(TrackChangeKind::Insert),
+                    "Delete" => Some(TrackChangeKind::Delete),
+                    "CharShape" => Some(TrackChangeKind::CharShape),
+                    "ParaShape" => Some(TrackChangeKind::ParaShape),
+                    _ => None,
+                }
+            }
+            b"date" => {
+                date = crate::model::memo_time::track_change_local_date(&attr_str(&attr))
+                    .unwrap_or_default()
+            }
+            b"authorID" => author_id = parse_u16(&attr),
+            b"hide" => hide = parse_bool(&attr),
+            b"id" => id = attr_str(&attr).parse::<usize>().ok(),
+            b"charshapeID" => char_shape = Some(parse_u32(&attr)),
+            b"parashapeID" => para_shape = Some(parse_u32(&attr)),
+            _ => {}
+        }
+    }
+    let change = kind.map(|kind| {
+        let shape_id = match kind {
+            TrackChangeKind::Insert | TrackChangeKind::Delete => None,
+            TrackChangeKind::CharShape => Some(char_shape.unwrap_or(0)),
+            TrackChangeKind::ParaShape => Some(para_shape.map_or(0, |id| id.saturating_add(1))),
+        };
+        TrackChange {
+            kind,
+            date,
+            author_id,
+            properties: if shape_id.is_some() { 4 } else { 0 },
+            shape_id,
+            hide,
+        }
+    });
+    let index = id
+        .and_then(|id| id.checked_sub(1))
+        .unwrap_or(doc_info.track_changes.len());
+    set_indexed(&mut doc_info.track_changes, index, change);
+}
+
+/// why-hwp: `<hh:trackChangeAuthor>` into `DocInfo::track_change_authors` at its
+/// one-based `id`, the index that `authorID` names.
+fn parse_track_change_author(e: &quick_xml::events::BytesStart, doc_info: &mut DocInfo) {
+    let mut name = String::new();
+    let mut mark = 0u32;
+    let mut id = None;
+    for attr in e.attributes().flatten() {
+        match attr.key.as_ref().as_bytes() {
+            b"name" => name = attr_str(&attr),
+            b"mark" => mark = parse_u32(&attr),
+            b"id" => id = attr_str(&attr).parse::<usize>().ok(),
+            _ => {}
+        }
+    }
+    let index = id
+        .and_then(|id| id.checked_sub(1))
+        .unwrap_or(doc_info.track_change_authors.len());
+    set_indexed(
+        &mut doc_info.track_change_authors,
+        index,
+        Some(crate::model::document::TrackChangeAuthor { name, mark }),
+    );
+}
+
