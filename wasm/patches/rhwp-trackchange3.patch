+
+// why-hwp: an HWPX with hidden tracked changes is exported from the file read again while
+// it is still as loaded, and an edited one is not exported at all.
+#[cfg(test)]
+mod hwpx_tracked_text_tests {
+    use super::DocumentCore;
+
+    fn deletions(document: &crate::model::document::Document) -> usize {
+        fn count(paragraphs: &[crate::model::paragraph::Paragraph]) -> usize {
+            paragraphs
+                .iter()
+                .map(|p| {
+                    p.range_tags
+                        .iter()
+                        .filter(|r| r.tag >> 24 == 0x11 && r.start < r.end)
+                        .count()
+                        + p.controls
+                            .iter()
+                            .filter_map(|c| match c {
+                                crate::model::control::Control::Table(t) => Some(
+                                    t.cells.iter().map(|cell| count(&cell.paragraphs)).sum::<usize>(),
+                                ),
+                                _ => None,
+                            })
+                            .sum::<usize>()
+                })
+                .sum()
+        }
+        document.sections.iter().map(|s| count(&s.paragraphs)).sum()
+    }
+
+    #[test]
+    fn edited_hwpx_with_hidden_tracked_changes_is_not_exported() {
+        let hwp = std::fs::read("samples/issue5169_viewtext_changetracking.hwp").unwrap();
+        let stored = crate::parser::with_tracked_text(|| crate::parser::parse_document(&hwp))
+            .unwrap();
+        let hwpx = DocumentCore::from_bytes(&hwp)
+            .unwrap()
+            .export_hwpx_native()
+            .unwrap();
+
+        let loaded = DocumentCore::from_bytes(&hwpx).unwrap();
+        assert!(loaded.tracked_text_source.is_some());
+        let written = loaded.export_hwp_with_adapter().unwrap();
+        let reread =
+            crate::parser::with_tracked_text(|| crate::parser::parse_document(&written)).unwrap();
+        let from_hwpx =
+            crate::parser::with_tracked_text(|| crate::parser::parse_document(&hwpx)).unwrap();
+        // 182 deletion ranges in the HWP; 5 of them hold only a paragraph break among other
+        // ranges and are written paraend="0", so 177 come back, as in Hancom Office's own
+        // HWP -> HWPX -> HWP round trip of this file (177 hp:deleteBegin).
+        assert_eq!(deletions(&stored), 182);
+        assert_eq!(deletions(&from_hwpx), 177);
+        assert_eq!(deletions(&reread), 177);
+        assert!(loaded.export_hwpx_native().is_ok());
+
+        let mut edited = DocumentCore::from_bytes(&hwpx).unwrap();
+        edited.convert_to_editable_native().unwrap();
+        assert!(edited.export_hwp_with_adapter().is_ok());
+        edited.insert_text_native(0, 0, 0, "x").unwrap();
+        for result in [
+            edited.export_hwp_with_adapter(),
+            edited.export_hwpx_native(),
+        ] {
+            let error = result.expect_err("edited document must not be exported");
+            assert!(error.to_string().contains("hidden tracked changes"), "{error}");
+        }
+    }
+}
