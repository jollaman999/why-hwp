+/// why-hwp: one `hp:insertBegin`, `hp:insertEnd`, `hp:deleteBegin` or `hp:deleteEnd`.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+struct TrackMarkPart {
+    delete: bool,
+    begin: bool,
+    /// `Id`: numbers the range in the document, in the order of the HWP range tags.
+    id: u32,
+    /// `TcId`: one-based index into `DocInfo::track_changes`.
+    tc_id: u32,
+    /// `paraend="1"`: the range takes the paragraph break.
+    para_end: bool,
+}
+
+impl TrackMarkPart {
+    fn read(local: &[u8], e: &quick_xml::events::BytesStart) -> Option<Self> {
+        let mut id = 0;
+        let mut tc_id = None;
+        let mut para_end = false;
+        for attr in e.attributes().flatten() {
+            match attr.key.as_ref().as_bytes() {
+                b"Id" => id = parse_u32(&attr),
+                b"TcId" => tc_id = Some(parse_u32(&attr)),
+                b"paraend" => para_end = parse_u8(&attr) == 1,
+                _ => {}
+            }
+        }
+        Some(Self {
+            delete: local.starts_with(b"delete"),
+            begin: local.ends_with(b"Begin"),
+            id,
+            tc_id: tc_id? & 0x00ff_ffff,
+            para_end,
+        })
+    }
+}
+
+/// why-hwp: the change tracking of one `hp:p`, gathered while it is read and turned into
+/// HWP range tags (kind 0x10 insertion, 0x11 deletion, 0x12 character shape change,
+/// 0x13 paragraph shape change; the low 24 bits are the `TcId`).
+#[derive(Debug, Default)]
+struct TrackedParagraph {
+    /// Insert and delete marks at their UTF-16 positions, in document order.
+    marks: Vec<(u32, TrackMarkPart)>,
+    /// Start of every `hp:run` and its `charTcId`.
+    runs: Vec<(u32, Option<u32>)>,
+    /// `hp:p/@paraTcId`.
+    para_tc_id: Option<u32>,
+}
+
+impl TrackedParagraph {
+    fn push_run(&mut self, pos: u32, e: &quick_xml::events::BytesStart) {
+        let tc_id = e
+            .attributes()
+            .flatten()
+            .find(|a| a.key.as_ref().as_bytes() == b"charTcId")
+            .map(|a| parse_u32(&a) & 0x00ff_ffff);
+        self.runs.push((pos, tc_id));
+    }
+
+    fn map_positions(&mut self, map: impl Fn(u32) -> u32) {
+        for (pos, _) in &mut self.marks {
+            *pos = map(*pos);
+        }
+        for (pos, _) in &mut self.runs {
+            *pos = map(*pos);
+        }
+    }
+
+    /// Range tags in the order Hancom Office writes them: insertions and deletions by
+    /// `Id`, then character shape changes by position, then the paragraph shape change.
+    /// A mark pair is matched by kind and `Id`. A range that ends with `paraend="1"`,
+    /// or does not end in this paragraph, takes the paragraph break (`char_count`).
+    /// Empty ranges are left out, as Hancom Office leaves them out when it saves HWPX as
+    /// HWP (rhwp sample issue5169: its 590 paragraphs match but for these).
+    fn range_tags(&self, char_count: u32) -> Vec<RangeTag> {
+        let text_end = char_count.saturating_sub(1);
+        let tag = |kind: u32, tc_id: u32| (kind << 24) | tc_id;
+        let kind = |mark: &TrackMarkPart| if mark.delete { 0x11 } else { 0x10 };
+        let mut text: Vec<(u32, RangeTag)> = Vec::new();
+        let mut open: Vec<(u32, TrackMarkPart)> = Vec::new();
+        for &(pos, mark) in &self.marks {
+            if mark.begin {
+                open.push((pos, mark));
+                continue;
+            }
+            let start = open
+                .iter()
+                .rposition(|(_, begin)| begin.delete == mark.delete && begin.id == mark.id)
+                .map_or(0, |i| open.remove(i).0);
+            let end = if mark.para_end { char_count } else { pos };
+            if end <= start {
+                continue;
+            }
+            text.push((
+                mark.id,
+                RangeTag {
+                    start,
+                    end,
+                    tag: tag(kind(&mark), mark.tc_id),
+                },
+            ));
+        }
+        for (start, mark) in open {
+            if start >= char_count {
+                continue;
+            }
+            text.push((
+                mark.id,
+                RangeTag {
+                    start,
+                    end: char_count,
+                    tag: tag(kind(&mark), mark.tc_id),
+                },
+            ));
+        }
+        text.sort_by_key(|(id, _)| *id);
+        let mut tags: Vec<RangeTag> = text.into_iter().map(|(_, range)| range).collect();
+        for (i, &(start, tc_id)) in self.runs.iter().enumerate() {
+            let Some(tc_id) = tc_id else { continue };
+            let end = self.runs.get(i + 1).map_or(text_end, |next| next.0).min(text_end);
+            if end > start {
+                tags.push(RangeTag {
+                    start,
+                    end,
+                    tag: tag(0x12, tc_id),
+                });
+            }
+        }
+        if let Some(tc_id) = self.para_tc_id {
+            tags.push(RangeTag {
+                start: 0,
+                end: char_count,
+                tag: tag(0x13, tc_id),
+            });
+        }
+        tags
+    }
+}
