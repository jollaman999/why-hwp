@@ -55,0 +56,101 @@ fn test_serialize_id_mappings_uses_modern_count_table_size() {
+// why-hwp: change tracking read from HWPX is written as Hancom Office writes it in HWP:
+// authors then changes, after MEMO_SHAPE and before DOC_DATA, counted in ID_MAPPINGS.
+// An HWP source keeps its own records, which are not written twice.
+#[test]
+fn track_changes_from_the_model_are_written_with_their_counts() {
+    use crate::model::document::{RawRecord, TrackChange, TrackChangeAuthor, TrackChangeKind};
+
+    let change = |kind| TrackChange {
+        kind,
+        date: [2026, 1, 1, 9, 0],
+        author_id: 1,
+        properties: 0,
+        shape_id: None,
+        hide: false,
+    };
+    let mut doc_info = DocInfo::default();
+    doc_info.font_faces = vec![Vec::new(); 7];
+    doc_info.track_changes = vec![
+        Some(change(TrackChangeKind::Insert)),
+        Some(change(TrackChangeKind::Delete)),
+    ];
+    doc_info.track_change_authors = vec![Some(TrackChangeAuthor {
+        name: "A".into(),
+        mark: 1,
+    })];
+    doc_info.extra_records = vec![
+        RawRecord {
+            tag_id: tags::HWPTAG_MEMO_SHAPE,
+            level: 1,
+            data: vec![0; 22],
+        },
+        RawRecord {
+            tag_id: tags::HWPTAG_DOC_DATA,
+            level: 0,
+            data: vec![0; 4],
+        },
+    ];
+    let records = |doc_info: &DocInfo| {
+        let stream = serialize_doc_info(doc_info, &DocProperties::default());
+        Record::read_all(&stream).unwrap()
+    };
+    let id_mapping_counts = |records: &[Record]| {
+        let data = &records
+            .iter()
+            .find(|r| r.tag_id == tags::HWPTAG_ID_MAPPINGS)
+            .unwrap()
+            .data;
+        (
+            u32::from_le_bytes(data[64..68].try_into().unwrap()),
+            u32::from_le_bytes(data[68..72].try_into().unwrap()),
+        )
+    };
+
+    let written = records(&doc_info);
+    let tail: Vec<(u16, u16)> = written
+        .iter()
+        .skip_while(|r| r.tag_id != tags::HWPTAG_MEMO_SHAPE)
+        .map(|r| (r.tag_id, r.level))
+        .collect();
+    assert_eq!(
+        tail,
+        vec![
+            (tags::HWPTAG_MEMO_SHAPE, 1),
+            (tags::HWPTAG_TRACK_CHANGE_AUTHOR, 1),
+            (tags::HWPTAG_TRACK_CHANGE, 1),
+            (tags::HWPTAG_TRACK_CHANGE, 1),
+            (tags::HWPTAG_DOC_DATA, 0),
+        ]
+    );
+    let insert = written
+        .iter()
+        .find(|r| r.tag_id == tags::HWPTAG_TRACK_CHANGE)
+        .unwrap();
+    assert_eq!(insert.data, change(TrackChangeKind::Insert).to_record());
+    assert_eq!(id_mapping_counts(&written), (2, 1));
+
+    // An HWP source: three raw TRACK_CHANGE records and no raw author.
+    let raw = change(TrackChangeKind::Insert).to_record();
+    doc_info.extra_records.truncate(1);
+    for _ in 0..3 {
+        doc_info.extra_records.push(RawRecord {
+            tag_id: tags::HWPTAG_TRACK_CHANGE,
+            level: 1,
+            data: raw.clone(),
+        });
+    }
+    let written = records(&doc_info);
+    let changes = written
+        .iter()
+        .filter(|r| r.tag_id == tags::HWPTAG_TRACK_CHANGE)
+        .count();
+    let authors = written
+        .iter()
+        .filter(|r| r.tag_id == tags::HWPTAG_TRACK_CHANGE_AUTHOR)
+        .count();
+    assert_eq!((changes, authors), (3, 0));
+    assert_eq!(id_mapping_counts(&written), (3, 0));
+
+    assert_eq!(id_mapping_counts(&records(&DocInfo::default())), (0, 0));
+}
