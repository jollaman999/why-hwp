+
+/// why-hwp: the HWP form of an HWPX change-tracking date, the reverse of
+/// [`track_change_date`]: local time of this PC, seconds dropped.
+pub(crate) fn track_change_local_date(value: &str) -> Option<[u16; 5]> {
+    track_change_local_date_in(value, &memo_zone())
+}
+
+fn track_change_local_date_in<Tz: chrono::TimeZone>(value: &str, zone: &Tz) -> Option<[u16; 5]> {
+    use chrono::{Datelike, Timelike};
+    let moment = match DateTime::parse_from_rfc3339(value.trim()) {
+        Ok(moment) => moment.with_timezone(&Utc),
+        Err(_) => chrono::NaiveDateTime::parse_from_str(value.trim(), "%Y-%m-%dT%H:%M:%S")
+            .ok()?
+            .and_utc(),
+    };
+    let local = moment.with_timezone(zone);
+    Some([
+        u16::try_from(local.year()).ok()?,
+        local.month() as u16,
+        local.day() as u16,
+        local.hour() as u16,
+        local.minute() as u16,
+    ])
+}
+
+#[cfg(test)]
+mod local_date_tests {
+    #[test]
+    fn track_change_date_is_read_into_local_time() {
+        // Hancom Office on a +09:00 PC saved date="2026-01-01T00:00:00Z" as 2026-01-01 09:00.
+        let seoul = chrono::FixedOffset::east_opt(9 * 3600).unwrap();
+        assert_eq!(
+            super::track_change_local_date_in("2026-01-01T00:00:00Z", &seoul),
+            Some([2026, 1, 1, 9, 0])
+        );
+        assert_eq!(
+            super::track_change_local_date_in("2017-03-22T06:11:59Z", &seoul),
+            Some([2017, 3, 22, 15, 11])
+        );
+        assert_eq!(
+            super::track_change_local_date_in("2026-03-18T20:00:00", &seoul),
+            Some([2026, 3, 19, 5, 0])
+        );
+        assert_eq!(super::track_change_local_date_in("", &seoul), None);
+    }
+}
