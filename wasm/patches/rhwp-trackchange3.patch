+impl TrackChange {
+    /// why-hwp: the `HWPTAG_TRACK_CHANGE` record that [`Self::from_record`] reads.
+    pub fn to_record(&self) -> Vec<u8> {
+        let mut data = Vec::with_capacity(30);
+        data.extend_from_slice(&self.kind.code().to_le_bytes());
+        for part in self.date {
+            data.extend_from_slice(&part.to_le_bytes());
+        }
+        data.extend_from_slice(&self.author_id.to_le_bytes());
+        data.extend_from_slice(&[0; 2]);
+        data.extend_from_slice(&self.properties.to_le_bytes());
+        if let Some(shape_id) = self.shape_id {
+            data.extend_from_slice(&shape_id.to_le_bytes());
+        }
+        data.extend_from_slice(&u32::from(self.hide).to_le_bytes());
+        data
+    }
+}
+
+impl TrackChangeAuthor {
+    /// why-hwp: the `HWPTAG_TRACK_CHANGE_AUTHOR` record, with the last four bytes zero
+    /// as Hancom Office writes them when it saves HWPX as HWP.
+    pub fn to_record(&self) -> Vec<u8> {
+        let units: Vec<u16> = self.name.encode_utf16().collect();
+        let mut data = Vec::with_capacity(12 + units.len() * 2);
+        data.extend_from_slice(&(units.len() as u32).to_le_bytes());
+        for unit in units {
+            data.extend_from_slice(&unit.to_le_bytes());
+        }
+        data.extend_from_slice(&self.mark.to_le_bytes());
+        data.extend_from_slice(&[0; 4]);
+        data
+    }
+}
