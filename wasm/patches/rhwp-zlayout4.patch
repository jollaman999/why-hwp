+/// why-hwp: a TrueType slot whose face is not installed and is painted with a
+/// display substitute, while its layout keeps the source face's widths.
+///
+/// The environment maps the missing face onto a supplied one for display only and
+/// keeps the source face as the metric face, so glyph origins are where the source
+/// face puts them. Drawn at the substitute's own width, a glyph box ends short or
+/// long of its advance. fdi-2025q2: 돋움체 `.` advances 0.5 em, the substitute's
+/// period is 0.27 em wide. HFT slots keep their own fitting rules above.
+fn draws_with_display_substitute(style: &TextStyle) -> bool {
+    if style.source_font_is_hft || style.preserve_glyph_ink {
+        return false;
+    }
+    let Some(metric_face) = style.metric_font_family.as_deref() else {
+        return false;
+    };
+    let drawn_face = super::style_resolver::primary_font_name(&style.font_family)
+        .trim_matches(['\'', '"']);
+    !drawn_face.is_empty() && !drawn_face.eq_ignore_ascii_case(metric_face.trim())
+}
