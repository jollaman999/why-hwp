# rhwp glyph fit for why-hwp: draw a display substitute at the source face's widths.
# Base: rhwp 981ce66b4 (v0.9.1) after the source edits in wasm/patch-rhwp.sh and every
# earlier wasm/patches/*.patch in name order; apply this after
# rhwp-zlayout3.patch.
# Zero-context diff (apply with git apply --unidiff-zero).
#
# When a document's face is not installed, the font environment maps it onto a
# supplied face for display only and keeps the missing face as the metric face
# (TextStyle::metric_font_family), so glyph origins are where the missing face
# puts them. The glyphs were drawn at the substitute's own widths, so their
# boxes in the PDF ended short or long: on Linux, 돋움체 `.` advances 0.5 em
# and the substitute draws it 0.27 em wide; 한컴 윤고딕 250 Hangul advances
# 0.9 em and HCR Dotum draws it 0.97 em wide.
#
# - svg.rs: a cluster of a TrueType slot whose drawn face is not its metric face
#   is fitted to its layout advance with textLength, as ASCII letters and digits
#   already are. Installed faces have no metric face and are drawn as before.
#   Footnote markers are drawn as their source run since rhwp 050e78455, so
#   they are fitted the same way.
# - svg/tests.rs covers it.
diff --git a/src/renderer/svg.rs b/src/renderer/svg.rs
index c7a529c570..4ae05cdb5b 100644
--- a/src/renderer/svg.rs
+++ b/src/renderer/svg.rs
@@ -4640 +4640,3 @@ fn svg_cluster_text_length_attrs(
-        fit_narrow_hangul || is_original_program_glyph(cluster_str, style),
+        fit_narrow_hangul
+            || is_original_program_glyph(cluster_str, style)
+            || draws_with_display_substitute(style),
@@ -4643,0 +4646,20 @@ fn svg_cluster_text_length_attrs(
+/// why-hwp: a TrueType slot whose face is not installed and is painted with a
+/// display substitute, while its layout keeps the source face's widths.
+///
+/// The environment maps the missing face onto a supplied one for display only and
+/// keeps the source face as the metric face, so glyph origins are where the source
+/// face puts them. Drawn at the substitute's own width, a glyph box ends short or
+/// long of its advance. fdi-2025q2: 돋움체 `.` advances 0.5 em, the substitute's
+/// period is 0.27 em wide. HFT slots keep their own fitting rules above.
+fn draws_with_display_substitute(style: &TextStyle) -> bool {
+    if style.source_font_is_hft || style.preserve_glyph_ink {
+        return false;
+    }
+    let Some(metric_face) = style.metric_font_family.as_deref() else {
+        return false;
+    };
+    let drawn_face = super::style_resolver::primary_font_name(&style.font_family)
+        .trim_matches(['\'', '"']);
+    !drawn_face.is_empty() && !drawn_face.eq_ignore_ascii_case(metric_face.trim())
+}
+
diff --git a/src/renderer/svg/tests.rs b/src/renderer/svg/tests.rs
index 31ad89f082..236f946ece 100644
--- a/src/renderer/svg/tests.rs
+++ b/src/renderer/svg/tests.rs
@@ -1677,0 +1678,36 @@ fn test_svg_original_program_glyph_is_fitted_to_its_advance() {
+#[test]
+fn test_svg_display_substitute_is_fitted_to_source_advance() {
+    // A missing 돋움체 slot painted with a display substitute keeps 돋움체's widths.
+    let font_size = 1000.0 / 75.0;
+    let style = |drawn: &str, metric: Option<&str>| TextStyle {
+        font_family: drawn.to_string(),
+        font_size,
+        ratio: 1.0,
+        metric_font_family: metric.map(str::to_string),
+        ..Default::default()
+    };
+    let text_length = |style: &TextStyle, ch: char| -> Option<f64> {
+        let mut renderer = SvgRenderer::new();
+        renderer.begin_page(800.0, 600.0);
+        renderer.draw_text(&format!("가{ch}나"), 10.0, 20.0, style);
+        let output = renderer.output();
+        let close = output
+            .find(&format!(">{ch}</text>"))
+            .unwrap_or_else(|| panic!("{ch:?} text: {output}"));
+        let tag = &output[output[..close].rfind("<text").unwrap()..close];
+        let at = tag.find(" textLength=\"")? + " textLength=\"".len();
+        let end = tag[at..].find('"').unwrap();
+        Some(tag[at..at + end].parse().unwrap())
+    };
+
+    let substituted = style("HCR Dotum", Some("돋움체"));
+    let period = text_length(&substituted, '.').expect("substituted 돋움체 . textLength");
+    assert!((period - 0.5 * font_size).abs() < 0.01, "{period}");
+    let hangul = text_length(&substituted, '다').expect("substituted 돋움체 다 textLength");
+    assert!((hangul - font_size).abs() < 0.01, "{hangul}");
+
+    // The face that placed the glyphs also draws them: its own widths stay.
+    assert_eq!(text_length(&style("돋움체", Some("돋움체")), '.'), None);
+    assert_eq!(text_length(&style("돋움체", None), '.'), None);
+}
+
