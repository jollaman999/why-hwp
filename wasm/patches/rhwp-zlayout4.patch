@@ -1677,0 +1678,77 @@ fn test_svg_original_program_glyph_is_fitted_to_its_advance() {
+#[test]
+fn test_svg_display_substitute_is_fitted_to_source_advance() {
+    // A missing 돋움체 slot painted with a display substitute keeps 돋움체's widths.
+    let font_size = 1000.0 / 75.0;
+    let style = |drawn: &str, metric: Option<&str>| TextStyle {
+        font_family: drawn.to_string(),
+        font_size,
+        ratio: 1.0,
+        metric_font_family: metric.map(str::to_string),
+        ..Default::default()
+    };
+    let text_length = |style: &TextStyle, ch: char| -> Option<f64> {
+        let mut renderer = SvgRenderer::new();
+        renderer.begin_page(800.0, 600.0);
+        renderer.draw_text(&format!("가{ch}나"), 10.0, 20.0, style);
+        let output = renderer.output();
+        let close = output
+            .find(&format!(">{ch}</text>"))
+            .unwrap_or_else(|| panic!("{ch:?} text: {output}"));
+        let tag = &output[output[..close].rfind("<text").unwrap()..close];
+        let at = tag.find(" textLength=\"")? + " textLength=\"".len();
+        let end = tag[at..].find('"').unwrap();
+        Some(tag[at..at + end].parse().unwrap())
+    };
+
+    let substituted = style("HCR Dotum", Some("돋움체"));
+    let period = text_length(&substituted, '.').expect("substituted 돋움체 . textLength");
+    assert!((period - 0.5 * font_size).abs() < 0.01, "{period}");
+    let hangul = text_length(&substituted, '다').expect("substituted 돋움체 다 textLength");
+    assert!((hangul - font_size).abs() < 0.01, "{hangul}");
+
+    // The face that placed the glyphs also draws them: its own widths stay.
+    assert_eq!(text_length(&style("돋움체", Some("돋움체")), '.'), None);
+    assert_eq!(text_length(&style("돋움체", None), '.'), None);
+}
+
+#[test]
+fn test_svg_footnote_marker_of_display_substitute_is_fitted() {
+    let marker = |drawn: &str, metric: Option<&str>| {
+        let mut renderer = SvgRenderer::new();
+        renderer.begin_page(800.0, 600.0);
+        renderer.render_node(&RenderNode::new(
+            0,
+            RenderNodeType::FootnoteMarker(super::super::render_tree::FootnoteMarkerNode {
+                number: 3,
+                text: "3)".to_string(),
+                base_font_size: 1000.0 / 75.0,
+                baseline: 10.0,
+                font_family: drawn.to_string(),
+                metric_font_family: metric.map(str::to_string),
+                color: 0,
+                section_index: 0,
+                para_index: 0,
+                control_index: 0,
+            }),
+            BoundingBox::new(10.0, 20.0, 10.0, 15.0),
+        ));
+        renderer.output().to_string()
+    };
+
+    // Each character is drawn at 돋움체's 0.5 em of the 3/4-size marker.
+    let fitted = marker("HCR Dotum", Some("돋움체"));
+    let lengths: Vec<f64> = fitted
+        .split(" textLength=\"")
+        .skip(1)
+        .map(|rest| rest[..rest.find('"').unwrap()].parse().unwrap())
+        .collect();
+    assert_eq!(lengths.len(), 2, "{fitted}");
+    assert!(lengths.iter().all(|w| (w - 5.0).abs() < 0.05), "{lengths:?}");
+    assert!(fitted.contains("font-family=\"&apos;HCR Dotum&apos;"), "{fitted}");
+
+    // An installed face keeps the single natural-width marker text.
+    let natural = marker("돋움체", None);
+    assert!(!natural.contains("textLength"), "{natural}");
+    assert!(natural.contains("font-family=\"돋움체\""), "{natural}");
+}
