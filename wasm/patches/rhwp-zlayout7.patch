# rhwp print geometry for why-hwp: place and size the glyphs of a run with a
# character width ratio as Hancom Office's PDF print does.
# Base: rhwp 7213ed1f9 after the source edits in wasm/patch-rhwp.sh and every
# earlier wasm/patches/*.patch in name order; apply this after
# rhwp-zlayout5.patch.
# Zero-context diff (apply with git apply --unidiff-zero).
#
# Hancom Office prints TrueType text through a 600 dpi GDI font whose lfWidth
# is round(ratio * xAvgCharWidth(regular face) * size). Its PDF draws that font
# with Tz = lfWidth / tmAveCharWidth (the drawn face's xAvgCharWidth at the
# rounded em, plus one pixel for synthesized bold): 휴먼명조 bold 14 pt at 98 %
# is Tz 95, not 98. Each glyph advances by the laid out distance between device
# pixels (positions truncated to the pixel), except a full width glyph whose
# laid out advance equals the em: it gets no adjustment and advances by its Tz
# scaled width. With ratio 98 % and spacing +2 % (a 14.0 pt pitch, laid out
# 117, 116, 117 pixels apart) the 117 ones advance 111.15 pixels. HFT text
# (Type 3) does the same with Tz equal to the ratio. The PDF places a run again
# after every space and where the script changes, so the shortfall adds up only
# inside a word.
#
# - gdi_text_out.rs: the Tz and em of a style, the glyph origins inside a word,
#   and the xAvgCharWidth of TrueType faces by family name (OS/2 of the
#   TrueType programs installed with Windows 11 and Hancom Office 2024;
#   metadata only, no font data). A slot not declared HFT whose face is in the
#   table is taken as TrueType, since HWP 5 documents seldom declare the type.
# - svg.rs: draw_text_positioned draws such a run at those origins and, for
#   TrueType, at that Tz; layout and the start of every word are unchanged.
diff --git a/src/renderer/gdi_text_out.rs b/src/renderer/gdi_text_out.rs
new file mode 100644
index 0000000..0ea4c7a
--- /dev/null
+++ b/src/renderer/gdi_text_out.rs
@@ -0,0 +1,967 @@
+//! why-hwp: where Hancom Office's PDF print puts the glyphs of a TrueType run
+//! with a character width ratio.
+//!
+//! Hancom Office prints TrueType text through a GDI font at 600 dpi whose
+//! `lfWidth` is `round(ratio * xAvgCharWidth(regular face) * size)`. The PDF
+//! writer draws that font with `Tz = lfWidth / tmAveCharWidth`, where
+//! `tmAveCharWidth` is the drawn face's `xAvgCharWidth` at the rounded em plus
+//! one pixel for synthesized bold. Each glyph advances by the laid out distance
+//! between device pixels (positions truncated to the pixel), except a full width glyph (advance of one em) whose
+//! laid out advance equals the em: it gets no adjustment and advances by its
+//! `Tz` scaled width. HFT text, printed as Type 3 fonts, does the same with
+//! `Tz` equal to the ratio. The writer places a run again after every space and
+//! where the script changes, so the shortfall adds up only inside a word.
+//!
+//! Measured on Hancom Office 2024 prints of 휴먼명조, 바탕, 맑은 고딕, 함초롬바탕,
+//! Arial and 한양신명조 (HFT) at 10-14 pt, ratio 90-100 %, spacing -3 to +10 %,
+//! bold and not.
+
+use super::font_metrics_data;
+use super::style_resolver;
+use super::TextStyle;
+
+const DEVICE_PER_PX: f64 = 600.0 / 96.0;
+const HWPUNIT_PER_PX: f64 = 7200.0 / 96.0;
+const HWPUNIT_PER_DEVICE: i64 = 12;
+
