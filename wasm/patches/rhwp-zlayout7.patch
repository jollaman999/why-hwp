+fn x_avg_char_width(names: &[&str], bold: bool, italic: bool) -> Option<(i64, i64)> {
+    names.iter().find_map(|name| {
+        X_AVG_CHAR_WIDTH
+            .binary_search_by(|&(n, b, i, _, _)| (n, b, i).cmp(&(*name, bold, italic)))
+            .ok()
+            .map(|k| (i64::from(X_AVG_CHAR_WIDTH[k].3), i64::from(X_AVG_CHAR_WIDTH[k].4)))
+    })
+}
+
+fn round_div(num: i64, den: i64) -> i64 {
+    (2 * num + den).div_euclid(2 * den)
+}
+
+/// Script classes the PDF writer starts a new run at.
+fn script_class(ch: char) -> Option<u8> {
+    if ch.is_whitespace() {
+        return None;
+    }
+    Some(match ch as u32 {
+        0x1100..=0x11FF | 0x3130..=0x318F | 0xA960..=0xA97F | 0xAC00..=0xD7A3 | 0xD7B0..=0xD7FF => 0,
+        0x3400..=0x4DBF | 0x4E00..=0x9FFF | 0xF900..=0xFAFF => 1,
+        _ => 2,
+    })
+}
+
+#[derive(Debug)]
+pub(crate) struct GdiTextOut {
+    metric: &'static font_metrics_data::FontMetric,
+    /// Rounded em in device pixels (the PDF `Tf`).
+    em: f64,
+    /// Horizontal scale of the drawn glyphs (the PDF `Tz`).
+    tz: f64,
+    /// Glyph ratio to draw with, relative to the style's font size. None for
+    /// HFT text, whose drawing keeps its own ratio contract.
+    draw_ratio: Option<f64>,
+}
+
+impl GdiTextOut {
+    pub(crate) fn for_style(style: &TextStyle) -> Option<Self> {
+        let ratio = (style.ratio * 100.0).round() as i64;
+        if ratio <= 0 || ratio == 100 {
+            return None;
+        }
+        let font_size = style.effective_font_size();
+        let height = (font_size * HWPUNIT_PER_PX).round() as i64;
+        if height <= 0 {
+            return None;
+        }
+        let em = round_div(height, HWPUNIT_PER_DEVICE);
+        let source = style_resolver::primary_font_name(
+            style.metric_font_family.as_deref().unwrap_or(&style.font_family),
+        );
+        let found = font_metrics_data::find_metric(source, style.bold, style.italic)?;
+        let metric = found.metric;
+        if metric.em_size == 0 {
+            return None;
+        }
+        if style.source_font_is_hft {
+            return Some(Self {
+                metric,
+                em: em as f64,
+                tz: ratio as f64 / 100.0,
+                draw_ratio: None,
+            });
+        }
+        // Any other slot is TrueType when the table knows its face; HWP 5
+        // documents seldom declare the type.
+        let names = [source, metric.name];
+        let regular = x_avg_char_width(&names, false, style.italic)
+            .or_else(|| x_avg_char_width(&names, false, false))?;
+        let (face, synthesized) = match style.bold {
+            true => x_avg_char_width(&names, true, style.italic)
+                .or_else(|| x_avg_char_width(&names, true, false))
+                .map_or((regular, true), |face| (face, false)),
+            false => (regular, false),
+        };
+        let width = round_div(ratio * regular.0 * height, 100 * regular.1 * HWPUNIT_PER_DEVICE);
+        let average = round_div(face.0 * em, face.1) + i64::from(synthesized);
+        if width <= 0 || average <= 0 {
+            return None;
+        }
+        let tz = width as f64 / average as f64;
+        Some(Self {
+            metric,
+            em: em as f64,
+            tz,
+            draw_ratio: Some(em as f64 * tz / (font_size * DEVICE_PER_PX)),
+        })
+    }
+
+    pub(crate) fn draw_ratio(&self) -> Option<f64> {
+        self.draw_ratio
+    }
+
+    /// Glyph origins of `text` drawn at `x`, from the laid out `positions`.
+    /// None when no glyph moves.
+    pub(crate) fn origins(&self, text: &str, x: f64, positions: &[f64]) -> Option<Vec<f64>> {
+        let chars: Vec<char> = text.chars().collect();
+        if positions.len() != chars.len() + 1 {
+            return None;
+        }
+        let device = |p: f64| ((x + p) * DEVICE_PER_PX + 1e-6).floor();
+        let em_size = self.metric.em_size;
+        let mut out = positions.to_vec();
+        let mut moved = false;
+        let mut lag = 0.0;
+        let mut previous: Option<u8> = None;
+        for (j, &ch) in chars.iter().enumerate() {
+            let class = script_class(ch);
+            if class.is_some() && previous.is_some() && previous != class {
+                lag = 0.0;
+            }
+            if lag != 0.0 {
+                out[j] = (device(positions[j]) - lag) / DEVICE_PER_PX - x;
+                moved = true;
+            }
+            let laid = device(positions[j + 1]) - device(positions[j]);
+            if self.metric.get_width(ch) == Some(em_size) && laid == self.em {
+                lag += laid - self.em * self.tz;
+            }
+            if class.is_none() {
+                lag = 0.0;
+                previous = None;
+            } else {
+                previous = class;
+            }
+        }
+        moved.then_some(out)
+    }
+}
