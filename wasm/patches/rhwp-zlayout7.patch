+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn style(face: &str, size_pt: f64, ratio: f64, bold: bool) -> TextStyle {
+        TextStyle {
+            font_family: face.to_string(),
+            font_size: size_pt * 96.0 / 72.0,
+            ratio,
+            bold,
+            ..Default::default()
+        }
+    }
+
+    #[test]
+    fn tz_follows_gdi_average_width() {
+        // Hancom Office 2024 PDF: Tf 117 with Tz 95 (bold, synthesized) and
+        // 96.6102 (regular) for 휴먼명조 14 pt at 98 %; Tz 88.3333 at 90 %;
+        // 맑은 고딕 Bold Tz 92.9825; 함초롬바탕 Bold Tz 98.1651; 10 pt Tf 83 Tz 95.3488.
+        let cases = [
+            ("휴먼명조", 14.0, 0.98, true, 117.0, 95.0),
+            ("휴먼명조", 14.0, 0.98, false, 117.0, 96.6102),
+            ("휴먼명조", 14.0, 0.90, true, 117.0, 88.3333),
+            ("휴먼명조", 12.0, 0.95, true, 100.0, 94.1176),
+            ("휴먼명조", 10.0, 0.98, true, 83.0, 95.3488),
+            ("바탕", 14.0, 0.98, true, 117.0, 95.0),
+            ("맑은 고딕", 14.0, 0.98, true, 117.0, 92.9825),
+            ("함초롬바탕", 14.0, 0.98, true, 117.0, 98.1651),
+        ];
+        for (face, size, ratio, bold, em, tz) in cases {
+            let out = GdiTextOut::for_style(&style(face, size, ratio, bold)).expect(face);
+            assert_eq!(out.em, em, "{face} {size} {ratio} {bold}");
+            assert!((out.tz * 100.0 - tz).abs() < 0.001, "{face} {size} {ratio} {bold}: {}", out.tz);
+        }
+        assert!(GdiTextOut::for_style(&style("휴먼명조", 14.0, 1.0, true)).is_none());
+        // Arial 14 pt: Tz 94.2308 at 95 %, 88.4615 at 90 %.
+        for (ratio, tz) in [(0.95, 94.2308), (0.90, 88.4615)] {
+            let out = GdiTextOut::for_style(&style("Arial", 14.0, ratio, false)).unwrap();
+            assert!((out.tz * 100.0 - tz).abs() < 0.001, "{ratio}: {}", out.tz);
+        }
+        // HFT: the Type 3 font is drawn with Tz equal to the ratio.
+        let mut hft = style("한양신명조", 14.0, 0.98, false);
+        hft.source_font_is_hft = true;
+        let out = GdiTextOut::for_style(&hft).unwrap();
+        assert_eq!((out.em, out.tz, out.draw_ratio()), (117.0, 0.98, None));
+    }
+
+    /// Left margin of the measured prints: 5669 HWPUNIT, 472.42 device pixels.
+    const X: f64 = 5669.0 / HWPUNIT_PER_PX;
+
+    fn device(x: f64) -> Vec<f64> {
+        vec![(X + x) * DEVICE_PER_PX]
+    }
+
+    #[test]
+    fn glyph_with_unscaled_advance_keeps_its_drawn_width() {
+        // 휴먼명조 bold 14 pt, 98 % and +2 %, from the left margin: the 14 pt
+        // pitch truncated to device pixels lays the glyphs out 117, 116, 117,
+        // 117, 116 apart. Hancom Office's PDF draws them at 472, 583.15,
+        // 699.15, 810.30, 921.45: the 117 ones advance 111.15 (Tz 95).
+        let st = style("휴먼명조", 14.0, 0.98, true);
+        let out = GdiTextOut::for_style(&st).unwrap();
+        let pitch = 14.0 * 96.0 / 72.0;
+        let positions: Vec<f64> = (0..=7).map(|i| f64::from(i) * pitch).collect();
+        let origins = out.origins("어지러움 흉통", X, &positions).unwrap();
+        let drawn: Vec<f64> = origins.iter().flat_map(|&p| device(p)).collect();
+        assert!((drawn[0] - 472.42).abs() < 0.01, "{drawn:?}");
+        for (i, e) in [(1, 583.15), (2, 699.15), (3, 810.30)] {
+            assert!((drawn[i] - e).abs() < 0.01, "{i}: {drawn:?}");
+        }
+        // The word after the space starts at its laid out place again.
+        assert_eq!(origins[5], positions[5]);
+    }
+
+    #[test]
+    fn hft_full_width_glyph_lags_by_its_ratio() {
+        // 한양신명조 (HFT) 14 pt, 98 % and +2 %: Hancom Office's PDF advances
+        // a glyph laid out 117 pixels on by 114.66 (Tz 98).
+        let mut st = style("한양신명조", 14.0, 0.98, false);
+        st.source_font_is_hft = true;
+        let out = GdiTextOut::for_style(&st).unwrap();
+        let pitch = 14.0 * 96.0 / 72.0;
+        let positions: Vec<f64> = (0..=3).map(|i| f64::from(i) * pitch).collect();
+        let origins = out.origins("가나다", X, &positions).unwrap();
+        let drawn = device(origins[1])[0];
+        assert!((drawn - (472.0 + 117.0 * 0.98)).abs() < 0.01, "{drawn}");
+    }
+
+    #[test]
+    fn script_change_starts_a_new_run() {
+        let st = style("휴먼명조", 14.0, 0.98, true);
+        let out = GdiTextOut::for_style(&st).unwrap();
+        let pitch = 14.0 * 96.0 / 72.0;
+        let positions: Vec<f64> = (0..=3).map(|i| f64::from(i) * pitch).collect();
+        let origins = out.origins("건가,", X, &positions).unwrap();
+        assert!(origins[1] < positions[1] - 0.5);
+        assert_eq!(origins[2], positions[2]);
+    }
+
+    #[test]
+    fn no_glyph_moves_without_a_ratio_or_full_width_match() {
+        let pitch = 14.0 * 96.0 / 72.0;
+        let positions: Vec<f64> = (0..=3).map(|i| f64::from(i) * pitch * 0.98).collect();
+        let out = GdiTextOut::for_style(&style("휴먼명조", 14.0, 0.98, true)).unwrap();
+        assert!(out.origins("가나다", X, &positions).is_none());
+    }
+}
