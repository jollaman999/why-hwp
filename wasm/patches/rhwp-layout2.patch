+/// HWP5 `HWPTAG_DOC_DATA` 인쇄 항목 ID 와 HWPX `settings.xml` PrintInfo 항목 (한컴 출력 순서).
+///
+/// ID 는 레코드의 `(u16 id, u16 type, u32 value)` 항목에서 읽는다. 0x4006·0x4010·0x401a·
+/// 0x401f·0x4020 은 한글이 같은 HWP5 를 HWPX 로 저장한 결과와 값·유무로 대조했다.
+/// 0x400a·0x400e·0x401d 는 대조 문서에서 모두 0 이라 순서로만 정했다.
+const HWP5_PRINT_INFO_ITEMS: [(u16, &str, bool); 8] = [
+    (0x400a, "PrintAutoFootNote", true),
+    (0x400e, "PrintAutoHeadNote", true),
+    (0x4006, "PrintMethod", false),
+    (0x4010, "OverlapSize", false),
+    (0x401a, "PrintCropMark", false),
+    (0x401d, "BinderHoleType", false),
+    (0x401f, "ZoomX", false),
+    (0x4020, "ZoomY", false),
+];
+
+/// HWP5 `HWPTAG_DOC_DATA` 의 인쇄 설정을 한컴 `settings.xml` 의 PrintInfo 로 옮긴다.
+///
+/// 한글은 모아 찍기(PrintMethod 4·5) 등을 이 설정에서 읽는다. 빠지면 같은 문서가
+/// HWPX 에서 모아 찍기 없이 인쇄된다. DOC_DATA 에 인쇄 항목이 없으면 `None`.
+fn hwp5_print_info_settings_xml(doc: &Document) -> Option<String> {
+    let record = doc
+        .doc_info
+        .extra_records
+        .iter()
+        .find(|r| r.tag_id == crate::parser::tags::HWPTAG_DOC_DATA)?;
+    let values: Vec<(u16, u32)> = record
+        .data
+        .chunks_exact(8)
+        .map(|kv| {
+            (
+                u16::from_le_bytes([kv[0], kv[1]]),
+                u32::from_le_bytes([kv[4], kv[5], kv[6], kv[7]]),
+            )
+        })
+        .collect();
+    let mut items = String::new();
+    for (id, name, boolean) in HWP5_PRINT_INFO_ITEMS {
+        let Some(&(_, value)) = values.iter().find(|(key, _)| *key == id) else {
+            continue;
+        };
+        if boolean {
+            let _ = write!(
+                items,
+                r#"<config:config-item name="{name}" type="boolean">{}</config:config-item>"#,
+                value != 0
+            );
+        } else {
+            let _ = write!(
+                items,
+                r#"<config:config-item name="{name}" type="short">{value}</config:config-item>"#
+            );
+        }
+    }
+    if items.is_empty() {
+        return None;
+    }
+    let close = "</ha:HWPApplicationSetting>";
+    let base = static_assets::SETTINGS_XML.trim_end().strip_suffix(close)?;
+    Some(format!(
+        r#"{base}<config:config-item-set name="PrintInfo">{items}</config:config-item-set>{close}"#
+    ))
+}
+
