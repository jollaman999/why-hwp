--- a/src/renderer/layout.rs
+++ b/src/renderer/layout.rs
@@ -2271,0 +2272,52 @@ fn tac_paragraph_tail_stored_line_top(
+/// 공백만 있는 host 문단의 줄을 자기 아래로 밀어낸 문단 기준 자리차지 표인가.
+///
+/// 한/글은 이 표를 문단 상단(+ 세로 오프셋 + 바깥 위 여백)에 두고 공백 줄은 표 아래로
+/// 보낸다. 저장 사다리가 그 증거다 - 앞 문단 끝에서 이 문단 첫 줄까지의 간격이 표 상자
+/// (오프셋 + 바깥 여백 + 높이)와 정확히 같다. fdi-2025q2 1쪽 지역별 표: 앞 문단 끝
+/// 60151 + 1000 + 552 = 61703, 첫 줄 vpos 68526, 차이 6823 = 289 + 141 + 6252 + 141.
+/// 공백 줄을 먼저 흐름에 놓으면 표가 그 줄 높이만큼 내려간다(한컴 Print 대비 4.4pt).
+fn whitespace_host_line_pushed_below_float(
+    previous: Option<&Paragraph>,
+    para: &Paragraph,
+    table: &crate::model::table::Table,
+    control_index: usize,
+) -> bool {
+    use crate::model::paragraph::LineSeg;
+    let v_off = i64::from(signed_hwpunit(table.common.vertical_offset));
+    if !is_para_topbottom_float(&table.common)
+        || table.common.vert_align != crate::model::shape::VertAlign::Top
+        || table.caption.is_some()
+        || v_off < 0
+        || !para_has_visible_text(para)
+        || para_has_non_whitespace_text(para)
+        || para.stored_text_partition_is_dirty()
+        || para.cell_format_vpos_dirty
+        || para.line_segs.len() != 1
+        || control_line_seg_index(para, control_index) != Some(0)
+    {
+        return false;
+    }
+    let Some(previous) = previous.filter(|p| {
+        !p.stored_text_partition_is_dirty() && !p.cell_format_vpos_dirty
+    }) else {
+        return false;
+    };
+    let (Some(prev), Some(anchor)) = (previous.line_segs.last(), para.line_segs.first()) else {
+        return false;
+    };
+    if prev.tag & LineSeg::TAG_IMPLEMENTATION_PROPERTY != 0
+        || anchor.tag & LineSeg::TAG_IMPLEMENTATION_PROPERTY != 0
+        || prev.line_spacing < 0
+    {
+        return false;
+    }
+    let previous_end = i64::from(prev.vertical_pos)
+        + i64::from(prev.line_height)
+        + i64::from(prev.line_spacing);
+    let frame = v_off
+        + i64::from(table.outer_margin_top)
+        + i64::from(table.outer_margin_bottom)
+        + i64::from(table.common.height);
+    frame > 0 && i64::from(anchor.vertical_pos) - previous_end == frame
+}
+
