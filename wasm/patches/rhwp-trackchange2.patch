@@ -192,0 +208,97 @@ pub fn memo_field_children_xml(field: &Field) -> Option<String> {
+/// why-hwp: whether `field` is a memo read from HWP5: its identity is only the
+/// `MEMO/` command, with no HWPX parameters (the HWPX parser always keeps those).
+fn is_hwp_memo(field: &Field) -> bool {
+    matches!(field.field_type, FieldType::Memo | FieldType::Unknown)
+        && field.raw_type.is_none()
+        && field.raw_parameters_xml.is_none()
+        && field.parameters.is_empty()
+        && field.command.starts_with("MEMO/")
+}
+
+/// why-hwp: the `fieldid` of the `<hp:fieldEnd>` that closes `field` in its own
+/// paragraph. Hancom Office 2024 writes the memo field code `%%me` (623209829)
+/// on both ends of an HWP5 memo, and drops a memo end without it when it saves
+/// the HWPX again.
+pub(crate) fn end_field_id(field: &Field, range: &FieldRange) -> u32 {
+    if range.end_field_id == 0 && is_hwp_memo(field) {
+        tags::FIELD_MEMO
+    } else {
+        range.end_field_id
+    }
+}
+
+/// why-hwp: the `fieldid` of a field end whose begin is in an earlier paragraph.
+/// The HWP5 parser marks a memo's end with `begin_ctrl_id == FIELD_MEMO`.
+pub(crate) fn orphan_end_field_id(end: &OrphanFieldEnd) -> u32 {
+    if end.field_id == 0 && end.begin_ctrl_id == tags::FIELD_MEMO {
+        tags::FIELD_MEMO
+    } else {
+        end.field_id
+    }
+}
+
+/// why-hwp: `<hh:memoProperties>` for the header. An HWPX source keeps its own
+/// block; an HWP5 source gets one `memoPr` per DocInfo MEMO_SHAPE record, with ids
+/// from 1 in record order, as Hancom Office 2024 writes it. `None` when there is
+/// no record or a record holds a value with no known HWPX name.
+pub(crate) fn memo_properties_xml(doc_info: &DocInfo) -> Option<Cow<'_, str>> {
+    if let Some(xml) = &doc_info.memo_properties_xml {
+        return Some(Cow::Borrowed(xml));
+    }
+    let mut items = Vec::new();
+    for record in &doc_info.extra_records {
+        if record.tag_id == tags::HWPTAG_MEMO_SHAPE {
+            items.push(memo_pr_xml(items.len() + 1, &record.data)?);
+        }
+    }
+    if items.is_empty() {
+        return None;
+    }
+    Some(Cow::Owned(format!(
+        r#"<hh:memoProperties itemCnt="{}">{}</hh:memoProperties>"#,
+        items.len(),
+        items.concat()
+    )))
+}
+
+/// One `<hh:memoPr>` from a MEMO_SHAPE record: width (u32), line type (u8), line
+/// width (u8), line, fill and active colors (COLORREF), memo type (u32). The
+/// inverse of `parser::hwpx::header::parse_memo_shape`.
+fn memo_pr_xml(id: usize, data: &[u8]) -> Option<String> {
+    let u32_at = |at: usize| Some(u32::from_le_bytes(data.get(at..at + 4)?.try_into().ok()?));
+    let line_type = match *data.get(4)? {
+        1 => "SOLID",
+        2 => "DASH_DOT",
+        3 => "DASH",
+        4 => "DASH_DOT_DOT",
+        5 => "LONG_DASH",
+        6 => "CIRCLE",
+        7 => "DOUBLE_SLIM",
+        8 => "SLIM_THICK",
+        9 => "THICK_SLIM",
+        10 => "SLIM_THICK_SLIM",
+        11 => "WAVE",
+        12 => "DOUBLE_WAVE",
+        13 => "DOT",
+        _ => return None,
+    };
+    let memo_type = match u32_at(18)? {
+        0 => "NOMAL",
+        _ => return None,
+    };
+    Some(format!(
+        concat!(
+            r#"<hh:memoPr id="{}" width="{}" lineWidth="{}" lineType="{}" "#,
+            r#"lineColor="{}" fillColor="{}" activeColor="{}" memoType="{}"/>"#,
+        ),
+        id,
+        u32_at(0)?,
+        data.get(5)?,
+        line_type,
+        super::shape::color_to_hex(u32_at(6)?),
+        super::shape::color_to_hex(u32_at(10)?),
+        super::shape::color_to_hex(u32_at(14)?),
+        memo_type,
+    ))
+}
+
