+    /// why-hwp: `testdata/sample.hwp` memo as rhwp reads it from HWP5.
+    fn hwp_memo(number: u32) -> Field {
+        Field {
+            field_type: FieldType::Memo,
+            command: format!("MEMO/65535/{number}/221092112/31289753/why-hwp/\\;;"),
+            properties: 0x8001,
+            field_id: 1_244_479_872,
+            ctrl_id: tags::FIELD_UNKNOWN,
+            memo_index: number,
+            ..Default::default()
+        }
+    }
+
+    /// Hancom Office 2024 SaveAs HWPX of `testdata/sample.hwp`: the memo number is
+    /// the zorder, and `%%me` is the fieldid on both ends.
+    #[test]
+    fn hwp_memo_begin_has_zorder_and_fieldid() {
+        let tag = field_begin_open_tag(&hwp_memo(2));
+        assert_eq!(
+            tag,
+            r#"<hp:fieldBegin id="1244479872" type="MEMO" name="" editable="1" dirty="1" zorder="2" fieldid="623209829""#
+        );
+        let mut hwpx_memo = hwp_memo(2);
+        hwpx_memo.raw_parameters_xml = Some("<hp:parameters/>".to_string());
+        assert_eq!(
+            field_begin_open_tag(&hwpx_memo),
+            r#"<hp:fieldBegin id="1244479872" type="MEMO" name="" editable="1" dirty="1""#
+        );
+    }
+
+    #[test]
+    fn hwp_memo_end_gets_memo_fieldid() {
+        let range = FieldRange::default();
+        assert_eq!(end_field_id(&hwp_memo(1), &range), 623_209_829);
+        let kept = FieldRange {
+            end_field_id: 7,
+            ..Default::default()
+        };
+        assert_eq!(end_field_id(&hwp_memo(1), &kept), 7);
+        let mut hwpx_memo = hwp_memo(1);
+        hwpx_memo.raw_parameters_xml = Some("<hp:parameters/>".to_string());
+        assert_eq!(end_field_id(&hwpx_memo, &range), 0);
+        let click_here = Field {
+            field_type: FieldType::ClickHere,
+            ..Default::default()
+        };
+        assert_eq!(end_field_id(&click_here, &range), 0);
+    }
+
+    #[test]
+    fn orphan_memo_end_gets_memo_fieldid() {
+        let mut end = OrphanFieldEnd {
+            begin_id_ref: 1,
+            begin_ctrl_id: tags::FIELD_MEMO,
+            memo_index: 1,
+            ..Default::default()
+        };
+        assert_eq!(orphan_end_field_id(&end), 623_209_829);
+        end.field_id = 9;
+        assert_eq!(orphan_end_field_id(&end), 9);
+        end.field_id = 0;
+        end.begin_ctrl_id = tags::FIELD_CLICKHERE;
+        assert_eq!(orphan_end_field_id(&end), 0);
+    }
+
+    fn hwpx_entry(bytes: &[u8], name: &str) -> String {
+        use std::io::Read;
+        let mut archive = zip::ZipArchive::new(std::io::Cursor::new(bytes)).expect("zip");
+        let mut xml = String::new();
+        archive
+            .by_name(name)
+            .expect("entry")
+            .read_to_string(&mut xml)
+            .expect("utf-8");
+        xml
+    }
+
+    /// rhwp samples with HWP5 memos, against Hancom Office 2024 SaveAs HWPX of the
+    /// same files: english.hwp has 15 memos in one paragraph each, and
+    /// memo_field_hwp5.hwp has one memo that ends in a later paragraph.
+    #[test]
+    fn hwp_sample_memos_match_hancom_hwpx() {
+        for (path, memos, memo_properties) in [
+            (
+                "samples/basic/english.hwp",
+                15,
+                concat!(
+                    r#"<hh:memoProperties itemCnt="1"><hh:memoPr id="1" width="15591" "#,
+                    r##"lineWidth="5" lineType="DASH" lineColor="#A9A9A9" fillColor="#EDFFC8" "##,
+                    r##"activeColor="#D1CFFC" memoType="NOMAL"/></hh:memoProperties>"##,
+                ),
+            ),
+            (
+                "samples/issue5866/memo_field_hwp5.hwp",
+                1,
+                concat!(
+                    r#"<hh:memoProperties itemCnt="1"><hh:memoPr id="1" width="15591" "#,
+                    r##"lineWidth="1" lineType="SOLID" lineColor="#000000" fillColor="#CCFF99" "##,
+                    r##"activeColor="#FFFF99" memoType="NOMAL"/></hh:memoProperties>"##,
+                ),
+            ),
+        ] {
+            let bytes = std::fs::read(path).expect(path);
+            let doc = crate::parser::parse_hwp(&bytes).expect("parse hwp");
+            let hwpx = super::super::serialize_hwpx(&doc).expect("serialize hwpx");
+            let header = hwpx_entry(&hwpx, "Contents/header.xml");
+            let section = hwpx_entry(&hwpx, "Contents/section0.xml");
+            assert!(header.contains(memo_properties), "{path}: {header}");
+            assert!(section.contains(r#"memoShapeIDRef="1""#), "{path}");
+            for number in 1..=memos {
+                let begin = format!(r#"dirty="1" zorder="{number}" fieldid="623209829">"#);
+                assert_eq!(section.matches(&begin).count(), 1, "{path}: {begin}");
+            }
+            let ends = section.matches(r#"fieldid="623209829"/>"#).count();
+            assert_eq!(ends, memos as usize, "{path}");
+        }
+    }
