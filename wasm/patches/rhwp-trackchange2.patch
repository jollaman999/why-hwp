# rhwp HWP memos for why-hwp: write them to HWPX as Hancom Office 2024 does.
# Base: rhwp 981ce66b4 (v0.9.1) after the source edits in wasm/patch-rhwp.sh and
# wasm/patches/rhwp-layout.patch to rhwp-layout7.patch and
# rhwp-trackchange.patch; apply this after rhwp-trackchange.patch.
# Zero-context diff (apply with git apply --unidiff-zero). Every hunk inserts
# lines or changes lines of rhwp itself, away from the lines of the earlier
# patches.
#
# - The memo hp:fieldBegin gets zorder (the memo number) and fieldid="623209829"
#   (the memo field code %%me), and its hp:fieldEnd gets the same fieldid, also
#   when the memo ends in a later paragraph. Hancom Office drops a memo end
#   without fieldid when it saves the HWPX again.
# - rhwp itself builds hh:memoProperties from the MEMO_SHAPE records and reads
#   secPr/@memoShapeIDRef from the HWP section definition since rhwp d7873c65b.
diff --git a/src/serializer/hwpx/field.rs b/src/serializer/hwpx/field.rs
index 11cda4a3a6..e95bfa2871 100644
--- a/src/serializer/hwpx/field.rs
+++ b/src/serializer/hwpx/field.rs
@@ -16,0 +17 @@ use crate::model::control::{Bookmark, Field, FieldType, Hyperlink};
+use crate::model::paragraph::{FieldRange, OrphanFieldEnd};
@@ -41,0 +43,12 @@ pub fn field_begin_open_tag(field: &Field) -> String {
+    if is_hwp_memo(field) {
+        return format!(
+            r#"<hp:fieldBegin id="{}" type="{}" name="{}" editable="{}" dirty="{}" zorder="{}" fieldid="{}""#,
+            id_str,
+            ft,
+            name,
+            bool01(field.is_editable_in_form()),
+            bool01(field.is_dirty()),
+            crate::parser::body_text::memo_field_number(field),
+            field.instance_id.unwrap_or(tags::FIELD_MEMO),
+        );
+    }
@@ -192,0 +206,32 @@ pub fn memo_field_children_xml(field: &Field) -> Option<String> {
+/// why-hwp: whether `field` is a memo read from HWP5: its identity is only the
+/// `MEMO/` command, with no HWPX parameters (the HWPX parser always keeps those).
+fn is_hwp_memo(field: &Field) -> bool {
+    matches!(field.field_type, FieldType::Memo | FieldType::Unknown)
+        && field.raw_type.is_none()
+        && field.raw_parameters_xml.is_none()
+        && field.parameters.is_empty()
+        && field.command.starts_with("MEMO/")
+}
+
+/// why-hwp: the `fieldid` of the `<hp:fieldEnd>` that closes `field` in its own
+/// paragraph. Hancom Office 2024 writes the memo field code `%%me` (623209829)
+/// on both ends of an HWP5 memo, and drops a memo end without it when it saves
+/// the HWPX again.
+pub(crate) fn end_field_id(field: &Field, range: &FieldRange) -> u32 {
+    if range.end_field_id == 0 && is_hwp_memo(field) {
+        tags::FIELD_MEMO
+    } else {
+        range.end_field_id
+    }
+}
+
+/// why-hwp: the `fieldid` of a field end whose begin is in an earlier paragraph.
+/// The HWP5 parser marks a memo's end with `begin_ctrl_id == FIELD_MEMO`.
+pub(crate) fn orphan_end_field_id(end: &OrphanFieldEnd) -> u32 {
+    if end.field_id == 0 && end.begin_ctrl_id == tags::FIELD_MEMO {
+        tags::FIELD_MEMO
+    } else {
+        end.field_id
+    }
+}
+
@@ -640,0 +686,118 @@ mod tests {
