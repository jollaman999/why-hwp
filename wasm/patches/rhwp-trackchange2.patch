# rhwp HWP memos for why-hwp: write them to HWPX as Hancom Office 2024 does.
# Base: rhwp 7213ed1f9 after the source edits in wasm/patch-rhwp.sh and
# wasm/patches/rhwp-layout.patch to rhwp-layout8.patch and
# rhwp-trackchange.patch; apply this after rhwp-trackchange.patch.
# Zero-context diff (apply with git apply --unidiff-zero). Every hunk inserts
# lines or changes lines of rhwp itself, away from the lines of the earlier
# patches.
#
# - The memo hp:fieldBegin gets zorder (the memo number) and fieldid="623209829"
#   (the memo field code %%me), and its hp:fieldEnd gets the same fieldid, also
#   when the memo ends in a later paragraph. Hancom Office drops a memo end
#   without fieldid when it saves the HWPX again.
# - hh:memoProperties is built from the DocInfo MEMO_SHAPE records, and
#   secPr/@memoShapeIDRef is read from offset 30 of the HWP section definition.
#   Hancom Office writes both for every HWP that has them, memos or not.
diff --git a/src/parser/body_text.rs b/src/parser/body_text.rs
index 17489e1..8e8d165 100644
--- a/src/parser/body_text.rs
+++ b/src/parser/body_text.rs
@@ -1074,0 +1075,6 @@ fn parse_section_def(ctrl_data: &[u8], child_records: &[Record], ctrl_level: u16
+    // why-hwp: the u16 at offset 30 is the section's memo shape, a 1-based index
+    // into the DocInfo MEMO_SHAPE records (0 = none). Hancom Office 2024 writes
+    // HWPX secPr@memoShapeIDRef there and reads it back from there.
+    if let Some(bytes) = ctrl_data.get(30..32) {
+        sd.memo_shape_id = u16::from_le_bytes([bytes[0], bytes[1]]);
+    }
