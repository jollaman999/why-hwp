+/// why-hwp: the section definition of `testdata/sample.hwp` (CTRL_HEADER data
+/// after `secd`). Hancom Office 2024 writes it with memoShapeIDRef="1".
+#[test]
+fn section_def_reads_memo_shape_id() {
+    let mut ctrl_data = vec![0u8; 43];
+    ctrl_data[4..6].copy_from_slice(&1134u16.to_le_bytes());
+    ctrl_data[10..14].copy_from_slice(&8000u32.to_le_bytes());
+    ctrl_data[14..16].copy_from_slice(&1u16.to_le_bytes());
+    ctrl_data[30] = 1;
+    let sd = parse_section_def(&ctrl_data, &[], 1);
+    assert_eq!(sd.memo_shape_id, 1);
+    assert_eq!(sd.outline_numbering_id, 1);
+    assert_eq!(sd.raw_ctrl_extra.len(), 19);
+    ctrl_data[30] = 0;
+    assert_eq!(parse_section_def(&ctrl_data, &[], 1).memo_shape_id, 0);
+    assert_eq!(parse_section_def(&ctrl_data[..30], &[], 1).memo_shape_id, 0);
+}
