diff --git a/src/renderer/font_metrics_vertical.rs b/src/renderer/font_metrics_vertical.rs
index 702b0f3095..e5fff7cec6 100644
--- a/src/renderer/font_metrics_vertical.rs
+++ b/src/renderer/font_metrics_vertical.rs
@@ -35,0 +36,115 @@ pub(crate) fn win_descent_em(name: &str, bold: bool, italic: bool) -> Option<f64
+
+/// why-hwp: OS/2 sTypoAscender and sTypoDescender of source TrueType programs,
+/// read from the font files (Windows: gulim.ttc, batang.ttc, malgun.ttf,
+/// malgunbd.ttf, times.ttf, wingding.ttf; Hancom Office: H2*.TTF, HY*.TTF,
+/// HANYGO2*0.ttf, HYHWPEQ.TTF and the TrueType HMK*.TTF of its 휴먼 faces;
+/// NanumGothic*.ttf). PDF writers put these two
+/// values in a font descriptor's /Ascent and /Descent, and PDF text
+/// extraction builds a glyph's box from them. A display substitute has its
+/// own values, so its glyph boxes sit higher or lower on the same baseline.
+struct TypoMetric {
+    names: &'static [&'static str],
+    units_per_em: u16,
+    ascender: i16,
+    descender: i16,
+}
+
+const TYPO_METRICS: &[TypoMetric] = &[
+    TypoMetric {
+        names: &[
+            "Gulim", "GulimChe", "Dotum", "DotumChe", "Batang", "BatangChe", "Gungsuh",
+            "GungsuhChe",
+        ],
+        units_per_em: 1024,
+        ascender: 879,
+        descender: -145,
+    },
+    TypoMetric {
+        names: &[
+            "HYHeadLine-Medium", "HYMyeongJo-Extra", "HYGothic-Extra", "HYGothic-Medium",
+            "HYGraphic-Medium", "HYGungSo-Bold", "HYPMokGak-Bold", "HYPost-Light", "HYPost-Medium",
+            "HYShortSamul-Medium", "HYSinMyeongJo-Medium", "HYbdaL", "HYbdaM", "HYdnkB", "HYdnkM",
+            "HYkanB", "HYkanM", "HYnamB", "HYnamL", "HYnamM", "HYsanB", "HYsupB", "HYsupM",
+            "HYtbrB", "HYwulB", "HYwulM",
+        ],
+        units_per_em: 1024,
+        ascender: 879,
+        descender: -145,
+    },
+    TypoMetric {
+        names: &["Malgun Gothic"],
+        units_per_em: 2048,
+        ascender: 1638,
+        descender: -410,
+    },
+    TypoMetric {
+        names: &[
+            "Haan YGodic 230", "Haan YGodic 240", "Haan YGodic 250", "NanumGothic",
+            "NanumGothicExtraBold",
+        ],
+        units_per_em: 1000,
+        ascender: 800,
+        descender: -200,
+    },
+    TypoMetric {
+        names: &[
+            "휴먼명조", "HumanMyeongJo", "휴먼고딕", "휴먼가는샘체", "휴먼가는팸체", "휴먼굵은샘체",
+            "휴먼굵은팸체", "휴먼둥근헤드라인", "휴먼매직체", "휴먼아미체", "휴먼옛체", "휴먼중간샘체",
+            "휴먼중간팸체", "휴먼편지체",
+        ],
+        units_per_em: 512,
+        ascender: 440,
+        descender: -72,
+    },
+    TypoMetric {
+        names: &["HyhwpEQ"],
+        units_per_em: 1024,
+        ascender: 820,
+        descender: -204,
+    },
+    TypoMetric {
+        names: &["Times New Roman"],
+        units_per_em: 2048,
+        ascender: 1420,
+        descender: -442,
+    },
+    // The program stores a positive descender; it is kept as stored.
+    TypoMetric {
+        names: &["Wingdings"],
+        units_per_em: 2048,
+        ascender: 1579,
+        descender: 420,
+    },
+];
+
+/// Typographic ascender and descender of a source face in em, as its program
+/// states them. `None` for a face whose program has not been read. Every
+/// weight and style of a listed family states the same values.
+pub(crate) fn source_typo_vertical_em(name: &str) -> Option<(f64, f64)> {
+    let decision = find_metric_decision(name, false, false)?;
+    let metric = TYPO_METRICS
+        .iter()
+        .find(|entry| entry.names.contains(&decision.metric.name))?;
+    let em = f64::from(metric.units_per_em);
+    Some((f64::from(metric.ascender) / em, f64::from(metric.descender) / em))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::source_typo_vertical_em;
+
+    #[test]
+    fn source_typo_metrics_follow_program_and_alias() {
+        let gulim = (879.0 / 1024.0, -145.0 / 1024.0);
+        assert_eq!(source_typo_vertical_em("돋움체"), Some(gulim));
+        assert_eq!(source_typo_vertical_em("Gulim"), Some(gulim));
+        assert_eq!(source_typo_vertical_em("HY헤드라인M"), Some(gulim));
+        assert_eq!(
+            source_typo_vertical_em("맑은 고딕"),
+            Some((1638.0 / 2048.0, -410.0 / 2048.0))
+        );
+        assert_eq!(source_typo_vertical_em("휴먼명조"), Some((440.0 / 512.0, -72.0 / 512.0)));
+        assert_eq!(source_typo_vertical_em("HCR Dotum"), None);
+        assert_eq!(source_typo_vertical_em("No Such Face"), None);
+    }
+}
