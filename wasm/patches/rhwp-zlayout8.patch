@@ -4725,0 +4731,25 @@ fn draws_with_display_substitute(style: &TextStyle) -> bool {
+/// why-hwp: the source face of a run painted with a display substitute, when the
+/// typographic ascender and descender of its program are known. It goes first in
+/// the run's `font-family` list. It is not installed, so the substitute after it
+/// is still the face drawn; the PDF stage gives the substitute's glyphs the
+/// source face's /Ascent and /Descent, as the source face's own PDF has them.
+/// A metric face that names a measuring rule (Malgun Gothic's Hancom bold
+/// decoration) stands for the family it measures.
+fn display_substitute_source_family(style: &TextStyle) -> Option<&str> {
+    if !draws_with_display_substitute(style) {
+        return None;
+    }
+    let metric_face = style.metric_font_family.as_deref()?.trim();
+    let source = super::legacy_font_advances::measurement_face(metric_face);
+    let drawn_face = super::style_resolver::primary_font_name(&style.font_family)
+        .trim_matches(['\'', '"']);
+    if source.is_empty()
+        || source.contains(['\'', '"', ','])
+        || drawn_face.eq_ignore_ascii_case(source)
+    {
+        return None;
+    }
+    super::font_metrics_data::source_typo_vertical_em(source)?;
+    Some(source)
+}
+
diff --git a/src/renderer/svg/tests.rs b/src/renderer/svg/tests.rs
index a2eaa285d6..1bce18cb3a 100644
--- a/src/renderer/svg/tests.rs
+++ b/src/renderer/svg/tests.rs
@@ -1743,0 +1744,38 @@ fn test_svg_display_substitute_is_fitted_to_source_advance() {
+#[test]
+fn test_svg_display_substitute_names_source_face_first() {
+    let family = |drawn: &str, metric: Option<&str>| {
+        let style = TextStyle {
+            font_family: drawn.to_string(),
+            font_size: 12.0,
+            ratio: 1.0,
+            metric_font_family: metric.map(str::to_string),
+            ..Default::default()
+        };
+        let mut renderer = SvgRenderer::new();
+        renderer.begin_page(800.0, 600.0);
+        renderer.draw_text("가", 10.0, 20.0, &style);
+        let output = renderer.output();
+        let at = output.find("font-family=\"").expect("font-family") + "font-family=\"".len();
+        let end = output[at..].find('"').unwrap();
+        output[at..at + end].to_string()
+    };
+
+    // The source program's typographic metrics are known: it is named first.
+    let substituted = family("HCR Dotum", Some("돋움체"));
+    assert!(substituted.starts_with("&apos;돋움체&apos;,&apos;HCR Dotum&apos;"), "{substituted}");
+    let headline = family("HCR Dotum", Some("HY헤드라인M"));
+    assert!(headline.starts_with("&apos;HY헤드라인M&apos;,&apos;HCR Dotum&apos;"), "{headline}");
+    // A measuring-rule metric face is named by the family it measures.
+    let decorated = family("HCR Dotum", Some("MalgunGothic-HancomBoldDecoration"));
+    assert!(decorated.starts_with("&apos;Malgun Gothic&apos;,&apos;HCR Dotum&apos;"), "{decorated}");
+    assert_eq!(
+        family("Malgun Gothic", Some("MalgunGothic-HancomBoldDecoration")),
+        family("Malgun Gothic", None)
+    );
+
+    // Installed source face, no metric face, or a program not read: unchanged.
+    assert!(family("돋움체", Some("돋움체")).starts_with("&apos;돋움체&apos;,"));
+    assert!(family("HCR Dotum", None).starts_with("&apos;HCR Dotum&apos;,"));
+    assert!(family("HCR Batang", Some("HCR Dotum")).starts_with("&apos;HCR Batang&apos;,"));
+}
+
