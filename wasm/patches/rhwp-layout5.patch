+/// One glyph of a structure: origin, baseline and the two em sizes.
+#[derive(Debug, Clone, Copy, PartialEq)]
+pub(crate) struct StructureGlyph {
+    pub(crate) code: char,
+    pub(crate) x: f64,
+    pub(crate) baseline: f64,
+    pub(crate) size_x: f64,
+    pub(crate) size_y: f64,
+}
+
+/// Longest rule, in em, that is painted as the widened rule glyph. Poppler's
+/// Splash renderer (pdftoppm 26.01) drops a glyph painted about ten times
+/// wider than its size: it painted this glyph at 9.75 em and dropped it at
+/// 10 em, at 12 and 30 pt and at 72 and 200 dpi. A longer rule keeps its path.
+const RULE_GLYPH_MAX_EMS: f64 = 9.0;
+
+/// Hancom Office paints every rule (fraction, radical, overline) with the
+/// rule glyph at the text size, widened until its advance is the rule length.
+fn rule_glyph(start: f64, end: f64, center_y: f64, fs: f64) -> Option<StructureGlyph> {
+    let ink = RULE_INK;
+    (end > start && fs > 0.0 && end - start <= RULE_GLYPH_MAX_EMS * fs).then(|| StructureGlyph {
+        code: ink.code,
+        x: start,
+        baseline: center_y + (ink.y_min + ink.y_max) / 2.0 / 1024.0 * fs,
+        size_x: (end - start) * 1024.0 / (ink.x_max - ink.x_min),
+        size_y: fs,
+    })
+}
+
+/// Box of the outline's points, moved by (`dx`, `dy`): left, top, right, bottom.
+fn outline_box(
+    outline: &[super::GlyphOutlineCommand],
+    dx: f64,
+    dy: f64,
+) -> Option<(f64, f64, f64, f64)> {
+    use super::GlyphOutlineCommand as Command;
+    let mut points = outline.iter().flat_map(|command| match *command {
+        Command::Move(p) | Command::Line(p) => vec![p],
+        Command::Cubic(p) => p.to_vec(),
+        Command::Close => Vec::new(),
+    });
+    let first = points.next()?;
+    let (mut x0, mut y0, mut x1, mut y1) = (first.0, first.1, first.0, first.1);
+    for (px, py) in points {
+        x0 = x0.min(px);
+        x1 = x1.max(px);
+        y0 = y0.min(py);
+        y1 = y1.max(py);
+    }
+    (y1 > y0).then_some((x0 + dx, y0 + dy, x1 + dx, y1 + dy))
+}
+
+/// Hancom Office keeps the horizontal size of a radical or delimiter at the
+/// text size and stretches the glyph vertically. Give the glyph ink the
+/// height and the horizontal centre of the outline it stands for.
+fn stretched_glyph(
+    ink: StructureInk,
+    outline: &[super::GlyphOutlineCommand],
+    dx: f64,
+    dy: f64,
+    fs: f64,
+) -> Option<StructureGlyph> {
+    let (x0, y0, x1, y1) = outline_box(outline, dx, dy).filter(|_| fs > 0.0)?;
+    let size_y = (y1 - y0) * 1024.0 / (ink.y_max - ink.y_min);
+    Some(StructureGlyph {
+        code: ink.code,
+        x: (x0 + x1) / 2.0 - (ink.x_min + ink.x_max) / 2.0 / 1024.0 * fs,
+        baseline: y1 + ink.y_min / 1024.0 * size_y,
+        size_x: fs,
+        size_y,
+    })
+}
+
+/// Hancom Office assembles a left brace too tall for one glyph from a top,
+/// a middle and a bottom part at the text size: the top part's ink starts at
+/// the brace's top, the bottom part's ink ends at its bottom and the middle
+/// part is centred. One extender, stretched vertically, fills each gap. The
+/// extender overlaps its neighbours by the connector overlap of the public
+/// assembly this outline was built with.
+fn assembled_left_brace(
+    outline: &[super::GlyphOutlineCommand],
+    dx: f64,
+    dy: f64,
+    fs: f64,
+) -> Vec<Option<StructureGlyph>> {
+    let Some((x0, y0, x1, y1)) = outline_box(outline, dx, dy).filter(|_| fs > 0.0) else {
+        return vec![None];
+    };
+    let unit = fs / 1024.0;
+    let (top, middle, bottom, extender) = (
+        BRACE_TOP_INK,
+        BRACE_MIDDLE_INK,
+        BRACE_BOTTOM_INK,
+        BRACE_EXTENDER_INK,
+    );
+    let x = (x0 + x1) / 2.0 - (middle.x_min + top.x_max) / 2.0 * unit;
+    let part = |ink: StructureInk, baseline: f64| StructureGlyph {
+        code: ink.code,
+        x,
+        baseline,
+        size_x: fs,
+        size_y: fs,
+    };
+    let top_baseline = y0 + top.y_max * unit;
+    let middle_baseline = (y0 + y1) / 2.0 + (middle.y_min + middle.y_max) / 2.0 * unit;
+    let bottom_baseline = y1 + bottom.y_min * unit;
+    let overlap = super::brace_stretch::connector_overlap(fs);
+    let fill = |from: f64, to: f64| {
+        (to > from).then(|| {
+            let size_y = (to - from + 2.0 * overlap) * 1024.0 / (extender.y_max - extender.y_min);
+            StructureGlyph {
+                code: extender.code,
+                x,
+                baseline: to + overlap + extender.y_min / 1024.0 * size_y,
+                size_x: fs,
+                size_y,
+            }
+        })
+    };
+    vec![
+        Some(part(top, top_baseline)),
+        fill(
+            top_baseline - top.y_min * unit,
+            middle_baseline - middle.y_max * unit,
+        ),
+        Some(part(middle, middle_baseline)),
+        fill(
+            middle_baseline - middle.y_min * unit,
+            bottom_baseline - bottom.y_max * unit,
+        ),
+        Some(part(bottom, bottom_baseline)),
+    ]
+}
+
+/// Hancom Office paints a roman letter (function names) with the ASCII glyph
+/// of HyhwpEQ. The outline is the public letter fitted to that glyph's ink,
+/// so the glyph takes the outline's origin and baseline.
+fn roman_letter_glyph(
+    text: &str,
+    outline: &[super::GlyphOutlineCommand],
+    x: f64,
+    y: f64,
+    fs: f64,
+) -> Option<StructureGlyph> {
+    let mut letters = text.chars();
+    let letter = letters.next().filter(|_| letters.next().is_none())?;
+    let baseline = super::variable_outline::glyph_baseline(letter, fs, outline)?;
+    Some(StructureGlyph {
+        code: letter,
+        x,
+        baseline: y + baseline,
+        size_x: fs,
+        size_y: fs,
+    })
+}
+
+/// The glyphs Hancom Office paints a delimiter with: one stretched glyph for
+/// a text-height parenthesis or a brace, parts for a taller left brace. The
+/// taller right brace has no observed assembly and keeps its path, so a tall
+/// pair keeps both paths.
+#[allow(clippy::too_many_arguments)]
+fn delimiter_glyphs(
+    text: &str,
+    other: &str,
+    text_height: bool,
+    height: f64,
+    outline: &[super::GlyphOutlineCommand],
+    dx: f64,
+    dy: f64,
+    fs: f64,
+) -> Vec<Option<StructureGlyph>> {
+    let assembly = super::brace_stretch::is_assembly(height, fs);
+    let ink = match text {
+        "(" if text_height => LEFT_PAREN_INK,
+        ")" if text_height => RIGHT_PAREN_INK,
+        "{" if !assembly => LEFT_BRACE_INK,
+        "}" if !assembly => RIGHT_BRACE_INK,
+        "{" if other.is_empty() => return assembled_left_brace(outline, dx, dy, fs),
+        _ => return vec![None],
+    };
+    vec![stretched_glyph(ink, outline, dx, dy, fs)]
+}
+
+/// Write `element`, inside a hint group when hints are on and the structure
+/// has glyphs.
+fn push_structure(svg: &mut String, color: &str, glyphs: &[Option<StructureGlyph>], element: &str) {
+    let hints = STRUCTURE_GLYPH_HINTS.with(|flag| flag.get());
+    if !hints || glyphs.is_empty() || glyphs.iter().any(Option::is_none) {
+        svg.push_str(element);
+        return;
+    }
+    svg.push_str(&format!("<g {STRUCTURE_GLYPH_ATTR}=\"{color}"));
+    for glyph in glyphs.iter().flatten() {
+        svg.push_str(&format!(
+            ";{:x},{:.4},{:.4},{:.4},{:.4}",
+            glyph.code as u32, glyph.x, glyph.baseline, glyph.size_x, glyph.size_y,
+        ));
+    }
+    svg.push_str("\">");
+    svg.push_str(element);
+    svg.push_str("</g>");
+}
+
+/// Read back the fill and glyphs of a hint group's attribute value.
+pub(crate) fn parse_structure_glyphs(value: &str) -> Option<(&str, Vec<StructureGlyph>)> {
+    let mut fields = value.split(';');
+    let color = fields.next().filter(|color| !color.is_empty())?;
+    let mut glyphs = Vec::new();
+    for field in fields {
+        let mut parts = field.split(',');
+        let code = char::from_u32(u32::from_str_radix(parts.next()?, 16).ok()?)?;
+        let mut number = || parts.next()?.parse::<f64>().ok().filter(|v| v.is_finite());
+        glyphs.push(StructureGlyph {
+            code,
+            x: number()?,
+            baseline: number()?,
+            size_x: number()?,
+            size_y: number()?,
+        });
+    }
+    (!glyphs.is_empty()).then_some((color, glyphs))
+}
