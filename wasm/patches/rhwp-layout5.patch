+    static PDF_STRUCTURE_GLYPHS: std::cell::Cell<bool> = const { std::cell::Cell::new(false) };
+    static STRUCTURE_GLYPH_HINTS: std::cell::Cell<bool> = const { std::cell::Cell::new(false) };
+}
