+/// Attribute of the group that carries the HyhwpEQ glyphs of one structure.
+pub(crate) const STRUCTURE_GLYPH_ATTR: &str = "data-hyhwpeq";
+
+/// Run the page SVG rendering of a PDF export. Equations rendered inside
+/// offer their structures as HyhwpEQ glyphs to the PDF stage.
+pub(crate) fn with_structure_glyph_hints<R>(render: impl FnOnce() -> R) -> R {
+    struct Reset(bool);
+    impl Drop for Reset {
+        fn drop(&mut self) {
+            PDF_STRUCTURE_GLYPHS.with(|flag| flag.set(self.0));
+        }
+    }
+    let _reset = Reset(PDF_STRUCTURE_GLYPHS.with(|flag| flag.replace(true)));
+    render()
+}
