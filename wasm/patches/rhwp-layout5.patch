diff --git a/src/renderer/equation/font_frame_metrics.rs b/src/renderer/equation/font_frame_metrics.rs
index 87bdd4b54..a6734ca27 100644
--- a/src/renderer/equation/font_frame_metrics.rs
+++ b/src/renderer/equation/font_frame_metrics.rs
@@ -99,0 +100,17 @@ pub(super) fn for_size_at_dpi(fs: f64, dpi: f64) -> Option<FontFrameMetrics> {
+/// 표에 없는 크기의 글줄 프레임을 표의 행들이 따르는 규칙으로 구한다.
+/// 높이는 96DPI 정수 픽셀(75HU)로 반올림한 글자 크기이고, 프레임의
+/// 가운데가 수학 축이며 기준선은 축보다 0.36em 아래다. 이 파일과
+/// script_fraction_frame의 22개 크기 행의 높이가 모두 이 규칙과 일치한다.
+pub(super) fn grid_line_at_dpi(fs: f64, dpi: f64) -> (f64, f64) {
+    let unit = fs * crate::renderer::HWPUNIT_PER_INCH / dpi;
+    let height = (unit / 75.0).round().max(1.0) * 75.0 * dpi / crate::renderer::HWPUNIT_PER_INCH;
+    (height, height / 2.0 + fs * 0.36)
+}
+
+/// 같은 규칙의 일반 글자 분수: 분자·분모 글줄 사이가 0.3em이고
+/// 분수선(수학 축)은 그 가운데에 놓인다.
+pub(super) fn grid_fraction_at_dpi(fs: f64, dpi: f64) -> (f64, f64) {
+    let (line, _) = grid_line_at_dpi(fs, dpi);
+    (line * 2.0 + fs * 0.3, line + fs * 0.15 + fs * 0.36)
+}
+
@@ -229,0 +247,24 @@ pub(super) fn roman_at_dpi(fs: f64, dpi: f64, accent: bool) -> Option<(f64, f64)
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn grid_rule_reproduces_every_measured_line_and_fraction_height() {
+        let dpi = crate::renderer::DEFAULT_DPI;
+        let to_unit = |px: f64| px * crate::renderer::HWPUNIT_PER_INCH / dpi;
+        for row in METRICS {
+            let fs = crate::renderer::hwpunit_to_px(row[0] as i32, dpi);
+            let line = to_unit(grid_line_at_dpi(fs, dpi).0);
+            let fraction = to_unit(grid_fraction_at_dpi(fs, dpi).0);
+            assert!((line - f64::from(row[1])).abs() < 1e-6, "{row:?}: {line}");
+            assert!(
+                (fraction - f64::from(row[11])).abs() < 1e-6,
+                "{row:?}: {fraction}"
+            );
+        }
+        let fs = crate::renderer::hwpunit_to_px(2200, dpi);
+        assert!((to_unit(grid_line_at_dpi(fs, dpi).0) - 2175.0).abs() < 1e-6);
+        assert!((to_unit(grid_fraction_at_dpi(fs, dpi).0) - 5010.0).abs() < 1e-6);
+    }
+}
