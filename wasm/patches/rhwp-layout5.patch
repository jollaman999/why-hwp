+        );
+        // The same baselines Hancom Office printed: 396.41, 409.23, 422.18,
+        // and extenders 400.96 and 413.79 at 4.56 pt.
+        let expected = [396.41, 400.96, 409.23, 413.79, 422.18];
+        for (glyph, baseline) in glyphs.iter().zip(expected) {
+            assert!(
+                (glyph.baseline - baseline).abs() < 0.1,
+                "{glyph:?} {baseline}"
+            );
+            assert_eq!(glyph.size_x, fs);
+            assert_eq!(glyph.x, glyphs[0].x);
+        }
+        assert_eq!(glyphs[0].size_y, fs);
+        assert!((glyphs[1].size_y - 4.56).abs() < 0.1, "{:?}", glyphs[1]);
+        assert!((glyphs[3].size_y - 4.56).abs() < 0.1, "{:?}", glyphs[3]);
+        // Ink 15..455 of 1024 is centred on the outline.
+        assert!((glyphs[0].x + 235.0 / 1024.0 * fs - 4.0).abs() < 1e-9);
+
+        // Parts taller than the brace cannot be assembled: the path stays.
+        let short = [
+            Command::Move((2.0, 0.0)),
+            Command::Line((6.0, 0.0)),
+            Command::Line((6.0, 20.0)),
+            Command::Close,
+        ];
+        assert!(assembled_left_brace(&short, 0.0, 0.0, fs).contains(&None));
+        // A tall pair keeps both paths.
+        let pair = "left lbrace matrix {a # b # c # d # e # f} right rbrace";
+        let (_, glyphs) = structure_glyphs(pair);
+        assert!(glyphs.is_empty(), "{glyphs:?}");
+    }
