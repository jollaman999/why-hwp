diff --git a/src/renderer/pdf.rs b/src/renderer/pdf.rs
index 0fd489dba..177f2e372 100644
--- a/src/renderer/pdf.rs
+++ b/src/renderer/pdf.rs
@@ -1846,0 +1847,52 @@ fn decode_missing_hancom_equation_glyphs<'a>(
+/// Equation structures that Hancom Office paints with HyhwpEQ glyphs arrive
+/// as `<g data-hyhwpeq="...">` groups around the paths that draw them. Paint
+/// the glyphs when the font database holds the face; otherwise drop the group
+/// tags and keep the paths.
+#[cfg(not(all(target_arch = "wasm32", target_os = "unknown")))]
+fn apply_hancom_equation_structure_glyphs(
+    svg: &str,
+    face_available: bool,
+) -> std::borrow::Cow<'_, str> {
+    use crate::renderer::equation::svg_render::{parse_structure_glyphs, STRUCTURE_GLYPH_ATTR};
+    let open = format!("<g {STRUCTURE_GLYPH_ATTR}=\"");
+    const CLOSE: &str = "</g>";
+    if !svg.contains(&open) {
+        return std::borrow::Cow::Borrowed(svg);
+    }
+    let family = crate::renderer::equation::hancom_glyphs::FONT_FAMILY;
+    let mut out = String::with_capacity(svg.len());
+    let mut rest = svg;
+    while let Some(start) = rest.find(&open) {
+        out.push_str(&rest[..start]);
+        let after = &rest[start + open.len()..];
+        let parts = after.find("\">").and_then(|value_end| {
+            let body = &after[value_end + 2..];
+            let body_end = body.find(CLOSE)?;
+            Some((
+                &after[..value_end],
+                &body[..body_end],
+                &body[body_end + CLOSE.len()..],
+            ))
+        });
+        let Some((value, body, tail)) = parts else {
+            out.push_str(&open);
+            rest = after;
+            continue;
+        };
+        match parse_structure_glyphs(value).filter(|_| face_available) {
+            Some((color, glyphs)) => {
+                for glyph in glyphs {
+                    out.push_str(&format!(
+                        "<text x=\"0\" y=\"0\" transform=\"translate({:.4},{:.4}) scale({:.8},1)\" font-size=\"{:.4}\" fill=\"{color}\" font-family=\"{family}\">{}</text>\n",
+                        glyph.x, glyph.baseline, glyph.size_x / glyph.size_y, glyph.size_y, glyph.code,
+                    ));
+                }
+            }
+            None => out.push_str(body),
+        }
+        rest = tail;
+    }
+    out.push_str(rest);
+    std::borrow::Cow::Owned(out)
+}
+
