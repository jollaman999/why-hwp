+/// The equation fragment with each structure Hancom Office paints as a
+/// HyhwpEQ glyph (radical, rule, delimiter) wrapped in a
+/// `<g data-hyhwpeq="...">` group around the path it has today. The PDF stage
+/// swaps the group for the glyphs when its font database holds HyhwpEQ and
+/// unwraps it otherwise, which leaves the fragment as it is without hints.
+/// Returns `None` outside a PDF export, and when the node's fragment is not
+/// the plain rendering of its layout.
+pub(crate) fn structure_glyph_fragment(
+    equation: &crate::renderer::render_tree::EquationNode,
+) -> Option<String> {
+    if !PDF_STRUCTURE_GLYPHS.with(|flag| flag.get()) {
+        return None;
+    }
+    let render = || {
+        render_equation_svg(
+            &equation.layout_box,
+            &equation.color_str,
+            equation.font_size,
+        )
+    };
+    if render() != equation.svg_content {
+        return None;
+    }
+    Some(render_equation_svg_with_structure_glyphs(
+        &equation.layout_box,
+        &equation.color_str,
+        equation.font_size,
+    ))
+}
+
+pub(crate) fn render_equation_svg_with_structure_glyphs(
+    layout: &LayoutBox,
+    color: &str,
+    base_font_size: f64,
+) -> String {
+    STRUCTURE_GLYPH_HINTS.with(|flag| flag.set(true));
+    let hinted = render_equation_svg(layout, color, base_font_size);
+    STRUCTURE_GLYPH_HINTS.with(|flag| flag.set(false));
+    hinted
+}
