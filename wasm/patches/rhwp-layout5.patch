+    fn hyhwpeq_layout(script: &str, base_unit: i32) -> LayoutBox {
+        let dpi = crate::renderer::DEFAULT_DPI;
+        let mut layout = EqLayout::new(crate::renderer::hwpunit_to_px(base_unit, dpi));
+        layout.hancom_cjk_advance = true;
+        layout.hancom_latin = true;
+        layout.hancom_math_face = true;
+        layout.math_digit_advance = Some(512);
+        layout.layout(&EqParser::new(tokenize(script)).parse())
+    }
+
+    fn find_kind<'a>(
+        value: &'a LayoutBox,
+        y: f64,
+        accept: &dyn Fn(&LayoutKind) -> bool,
+    ) -> Option<(&'a LayoutBox, f64)> {
+        let y = y + value.y;
+        if accept(&value.kind) {
+            return Some((value, y));
+        }
+        match &value.kind {
+            LayoutKind::Row(items) => items.iter().find_map(|item| find_kind(item, y, accept)),
+            LayoutKind::Paren { body, .. }
+            | LayoutKind::Color { body, .. }
+            | LayoutKind::FontStyle { body, .. } => find_kind(body, y, accept),
+            _ => None,
+        }
+    }
+
+    /// 첫 글리프의 그려지는 기준선(부모 원점 기준, pt).
+    fn glyph_baseline_pt(value: &LayoutBox, y: f64) -> f64 {
+        let y = y + value.y;
+        match &value.kind {
+            LayoutKind::HancomGlyphs(run) => (y + value.baseline + run.baseline_shift) * 0.75,
+            LayoutKind::Row(items) => glyph_baseline_pt(&items[0], y),
+            LayoutKind::Superscript { base, .. } | LayoutKind::Subscript { base, .. } => {
+                glyph_baseline_pt(base, y)
+            }
+            LayoutKind::Paren { body, .. }
+            | LayoutKind::Color { body, .. }
+            | LayoutKind::FontStyle { body, .. } => glyph_baseline_pt(body, y),
+            _ => (y + value.baseline) * 0.75,
+        }
+    }
+
+    #[test]
+    fn hyhwpeq_script_fraction_follows_frame_rule_at_11pt() {
+        // 한글 2024 PDF(11pt, 25^{1 over 3}): 분자·분모 기준선은 본체 기준선보다
+        // 14.50pt, 4.79pt 위. 저장 높이 2287HU, 기준선 93%.
+        let layout = hyhwpeq_layout("25^{{1} over {3}}", 1100);
+        let (superscript, top) = find_kind(&layout, 0.0, &|kind| {
+            matches!(kind, LayoutKind::Superscript { .. })
+        })
+        .expect("superscript");
+        let LayoutKind::Superscript { base, sup } = &superscript.kind else {
+            unreachable!()
+        };
+        let fs = crate::renderer::hwpunit_to_px(1100, crate::renderer::DEFAULT_DPI);
+        let (height, baseline) =
+            crate::renderer::equation::logical_font_frame::metrics(superscript, fs)
+                .expect("script fraction frame");
+        let unit = crate::renderer::HWPUNIT_PER_INCH / crate::renderer::DEFAULT_DPI;
+        assert!((height * unit - 2287.0).abs() <= 0.5, "height {height}");
+        assert_eq!((baseline / height * 100.0).round(), 93.0);
+        let (fraction, fraction_top) = find_kind(sup, top, &|kind| {
+            matches!(kind, LayoutKind::Fraction { .. })
+        })
+        .expect("script fraction");
+        let LayoutKind::Fraction { numer, denom, .. } = &fraction.kind else {
+            unreachable!()
+        };
+        let base_line = glyph_baseline_pt(base, top);
+        let numer_rise = base_line - glyph_baseline_pt(numer, fraction_top);
+        let denom_rise = base_line - glyph_baseline_pt(denom, fraction_top);
+        assert!((numer_rise - 14.50).abs() < 0.35, "numerator {numer_rise}");
+        assert!((denom_rise - 4.79).abs() < 0.35, "denominator {denom_rise}");
+    }
+
+    #[test]
+    fn hyhwpeq_limit_name_and_lower_limit_follow_line_frames() {
+        // 한글 2024 PDF: 11pt는 이름 원점이 본체 기준선보다 0.55pt, 하한 기준선이
+        // 9.18pt 아래. 9pt(30곳)는 0.72~0.84pt, 7.20~7.44pt 아래.
+        for (unit, name_drop, sub_drop) in [(1100, 0.55, 9.18), (900, 0.78, 7.32)] {
+            let layout = hyhwpeq_layout("lim _{h rarrow 0} x", unit);
+            let (limit, top) =
+                find_kind(&layout, 0.0, &|kind| matches!(kind, LayoutKind::Limit { .. }))
+                    .expect("limit");
+            let LayoutKind::Limit { name, sub, .. } = &limit.kind else {
+                unreachable!()
+            };
+            let main = (top + limit.baseline) * 0.75;
+            let name = glyph_baseline_pt(name.as_deref().expect("name glyphs"), top) - main;
+            let sub = glyph_baseline_pt(sub.as_deref().expect("lower limit"), top) - main;
+            assert!((name - name_drop).abs() < 0.3, "{unit}: name {name}");
+            assert!((sub - sub_drop).abs() < 0.15, "{unit}: lower limit {sub}");
+        }
+    }
+
+    #[test]
+    fn hyhwpeq_cases_cells_share_the_frame_middle() {
+        // 한글 2024 PDF(11pt): x^2 칸 옆의 일반 글줄 칸은 기준선이 0.96pt 높다.
+        // 위첨자 프레임 1313HU와 글줄 프레임 1125HU의 가운데를 맞춘 값이다.
+        let layout = hyhwpeq_layout("cases{x ^{2} &a#b&c}", 1100);
+        let (body, top) = find_kind(&layout, 0.0, &|kind| {
+            matches!(kind, LayoutKind::Paren { left, .. } if left == "{")
+        })
+        .expect("cases");
+        let LayoutKind::Paren { body, .. } = &body.kind else {
+            unreachable!()
+        };
+        let LayoutKind::Row(rows) = &body.kind else {
+            panic!("cases rows")
+        };
+        let LayoutKind::Row(cells) = &rows[0].kind else {
+            panic!("cases cells")
+        };
+        let row_top = top + body.y + rows[0].y;
+        let rise = glyph_baseline_pt(&cells[0], row_top) - glyph_baseline_pt(&cells[1], row_top);
+        assert!((rise - 0.94).abs() < 0.03, "first row {rise}");
+        let LayoutKind::Row(cells) = &rows[1].kind else {
+            panic!("cases cells")
+        };
+        let row_top = top + body.y + rows[1].y;
+        let rise = glyph_baseline_pt(&cells[0], row_top) - glyph_baseline_pt(&cells[1], row_top);
+        assert!(rise.abs() < 1e-9, "second row {rise}");
+    }
