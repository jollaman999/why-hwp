@@ -4014,0 +4015,55 @@ endbfchar <DB80DEB1>";
+
+    #[test]
+    fn outline_marked_text_is_drawn_as_outlines_once() {
+        use usvg::fontdb::{Database, FaceInfo, Language, Source, Stretch, Style, Weight, ID};
+        assert_eq!(
+            crate::renderer::svg::OUTLINE_TEXT_ID_PREFIX,
+            svg2pdf::OUTLINE_TEXT_ID_PREFIX
+        );
+        let font: &[u8] = include_bytes!("../../tests/fixtures/fonts/RHWPExactKerningSmoke.ttf");
+        let mut database = Database::new();
+        database.push_face_info(FaceInfo {
+            id: ID::dummy(),
+            source: Source::Binary(std::sync::Arc::new(font.to_vec())),
+            index: 0,
+            families: vec![("Fixture".to_string(), Language::English_UnitedStates)],
+            post_script_name: "Fixture".to_string(),
+            style: Style::Normal,
+            weight: Weight::NORMAL,
+            stretch: Stretch::Normal,
+            monospaced: false,
+        });
+        let options = usvg::Options {
+            fontdb: std::sync::Arc::new(database),
+            ..Default::default()
+        };
+        let pdf = |body: &str| {
+            let svg = format!(
+                "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"200\" height=\"100\">\
+                 <g font-family=\"Fixture\" font-size=\"20\">{body}</g></svg>"
+            );
+            let tree = usvg::Tree::from_str(&svg, &options).unwrap();
+            let bytes = svg2pdf::to_pdf(
+                &tree,
+                svg2pdf::ConversionOptions {
+                    compress: false,
+                    ..Default::default()
+                },
+                Default::default(),
+            )
+            .unwrap();
+            let text = String::from_utf8_lossy(&bytes).into_owned();
+            let shows = text.lines().filter(|line| line.ends_with(" Tj")).count();
+            let fills = text.lines().filter(|line| line.trim() == "f").count();
+            (shows, fills)
+        };
+        let marked = format!(
+            "<text id=\"{}1\" x=\"10\" y=\"40\">HAT</text>",
+            svg2pdf::OUTLINE_TEXT_ID_PREFIX
+        );
+        let (shows, fills) = pdf(&marked);
+        assert_eq!(shows, 0);
+        assert!(fills > 0, "{fills}");
+        let (shows, _) = pdf("<text id=\"t1\" x=\"10\" y=\"40\">HAT</text>");
+        assert_eq!(shows, 3);
+    }
