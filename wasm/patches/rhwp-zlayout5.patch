@@ -4518,0 +4546,10 @@ fn color_to_svg(color: u32) -> String {
+/// why-hwp: id prefix of a `<text>` whose glyph the PDF stage draws as outlines.
+///
+/// A full-width HFT symbol drawn by a substitute face is centred in its cell
+/// (see `centers_in_fullwidth_cell`), so as text its PDF glyph box would be the
+/// substitute's own advance, half the cell for `–` in Malgun Gothic. Hancom Office
+/// draws the HFT glyph as outlines under invisible text one cell wide. The cell gets
+/// an invisible `<text>` fitted to it and the visible glyph is drawn as outlines, so
+/// the text is extracted once, from the cell. svg2pdf checks this prefix.
+pub(crate) const OUTLINE_TEXT_ID_PREFIX: &str = "rhwp-outline-text-";
+
