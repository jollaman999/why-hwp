+/// Write the outlines of the texts under each group with id `prefix` + n as
+/// filled `<path>` elements into `paths[n]`. An entry stays `None` when its
+/// texts give no outline or something other than a solid filled outline.
+#[cfg(not(all(target_arch = "wasm32", target_os = "unknown")))]
+fn collect_text_paths(
+    group: &usvg::Group,
+    prefix: &str,
+    index: Option<usize>,
+    paths: &mut [Option<String>],
+) {
+    use std::fmt::Write;
+    use usvg::tiny_skia_path::PathSegment;
+    let index = group
+        .id()
+        .strip_prefix(prefix)
+        .and_then(|n| n.parse::<usize>().ok())
+        .filter(|n| *n < paths.len())
+        .or(index);
+    for node in group.children() {
+        match node {
+            usvg::Node::Group(child) => collect_text_paths(child, prefix, index, paths),
+            usvg::Node::Text(text) => {
+                let Some(index) = index else { continue };
+                let mut drawn = String::new();
+                let mut solid = true;
+                for child in text.flattened().children() {
+                    let usvg::Node::Path(path) = child else {
+                        solid = false;
+                        continue;
+                    };
+                    let fill = path.fill().and_then(|fill| match fill.paint() {
+                        usvg::Paint::Color(color) => Some((*color, fill.opacity().get())),
+                        _ => None,
+                    });
+                    let data = path.data().clone().transform(text.abs_transform());
+                    let (Some((color, opacity)), Some(data), None) = (fill, data, path.stroke())
+                    else {
+                        solid = false;
+                        continue;
+                    };
+                    let mut d = String::new();
+                    for segment in data.segments() {
+                        let _ = match segment {
+                            PathSegment::MoveTo(p) => write!(d, "M{:.3} {:.3}", p.x, p.y),
+                            PathSegment::LineTo(p) => write!(d, "L{:.3} {:.3}", p.x, p.y),
+                            PathSegment::QuadTo(a, p) => {
+                                write!(d, "Q{:.3} {:.3} {:.3} {:.3}", a.x, a.y, p.x, p.y)
+                            }
+                            PathSegment::CubicTo(a, b, p) => write!(
+                                d,
+                                "C{:.3} {:.3} {:.3} {:.3} {:.3} {:.3}",
+                                a.x, a.y, b.x, b.y, p.x, p.y
+                            ),
+                            PathSegment::Close => write!(d, "Z"),
+                        };
+                    }
+                    let _ = write!(
+                        drawn,
+                        "<path d=\"{d}\" fill=\"#{:02x}{:02x}{:02x}\"",
+                        color.red, color.green, color.blue
+                    );
+                    if opacity < 1.0 {
+                        let _ = write!(drawn, " fill-opacity=\"{opacity}\"");
+                    }
+                    drawn.push_str("/>\n");
+                }
+                if !solid || drawn.is_empty() {
+                    paths[index] = None;
+                    continue;
+                }
+                paths[index].get_or_insert_with(String::new).push_str(&drawn);
+            }
+            _ => {}
+        }
