index 0000000000..90f429f02c
--- /dev/null
+++ b/src/renderer/equation/text_layer_face.rs
@@ -0,0 +1,326 @@
+//! A face that carries the text of HYhwpEQ glyphs in a PDF made without it.
+//!
+//! Hancom Office, and this producer when HYhwpEQ is installed, write the
+//! face's own codes (private-use digits and italic letters, structure parts)
+//! with its advances. Without the face the glyphs are drawn with other fonts,
+//! which report other characters and advances, so the text of the PDF would
+//! depend on the installed fonts. This face maps every code painted with
+//! HYhwpEQ to a box glyph with the HYhwpEQ advance and vertical metrics. It is
+//! painted transparent over the drawn glyphs. It holds those numbers only, no
+//! outline or byte of the original face.
+
+/// Family name of the generated face.
+pub(crate) const FAMILY: &str = "RHWP Equation Text";
+
+const POSTSCRIPT_NAME: &str = "RHWPEquationText";
+// HYHWPEQ.TTF hhea/OS/2 vertical metrics, UPM 1024.
+const UNITS_PER_EM: u16 = 1024;
+const ASCENDER: i16 = 820;
+const DESCENDER: i16 = -204;
+const LINE_GAP: i16 = 152;
+
+/// Every code painted with HYhwpEQ and its hmtx advance, by code.
+pub(crate) fn hyhwpeq_advances() -> Vec<(char, u16)> {
+    let mut advances: std::collections::BTreeMap<char, u16> =
+        super::hancom_glyphs::face_advances().clone();
+    for (code, advance) in super::svg_render::STRUCTURE_ADVANCES {
+        advances.entry(code).or_insert(advance);
+    }
+    advances.into_iter().collect()
+}
+
+/// The HYhwpEQ advance of `code`, when the face covers it.
+pub(crate) fn hyhwpeq_advance(code: char) -> Option<u16> {
+    super::hancom_glyphs::face_advances()
+        .get(&code)
+        .copied()
+        .or_else(|| {
+            super::svg_render::STRUCTURE_ADVANCES
+                .iter()
+                .find(|(c, _)| *c == code)
+                .map(|(_, advance)| *advance)
+        })
+}
+
+/// A TrueType face of [`FAMILY`] with one box glyph per BMP code of
+/// `glyphs`, each with its advance in 1/1024 em. Glyph 0 is an empty
+/// `.notdef`.
+pub(crate) fn build(glyphs: &[(char, u16)]) -> Vec<u8> {
+    let mut glyphs: Vec<(char, u16)> = glyphs
+        .iter()
+        .copied()
+        .filter(|(code, _)| (*code as u32) < 0xffff)
+        .collect();
+    glyphs.sort_by_key(|(code, _)| *code);
+    glyphs.dedup_by_key(|(code, _)| *code);
+    let count = u16::try_from(glyphs.len() + 1).unwrap_or(u16::MAX);
+    let glyphs = &glyphs[..usize::from(count) - 1];
+    let max_advance = glyphs.iter().map(|(_, a)| *a).max().unwrap_or(0);
+
+    let mut glyf = Vec::new();
+    let mut loca = vec![0u32, 0];
+    let mut hmtx = Vec::new();
+    put16(&mut hmtx, 0);
+    put16(&mut hmtx, 0);
+    for &(_, advance) in glyphs {
+        let right = i16::try_from(advance.max(1)).unwrap_or(i16::MAX);
+        put16(&mut glyf, 1);
+        for v in [0, DESCENDER, right, ASCENDER] {
+            put16(&mut glyf, v as u16);
+        }
+        put16(&mut glyf, 3);
+        put16(&mut glyf, 0);
+        glyf.extend_from_slice(&[1, 1, 1, 1]);
+        for dx in [0, right, 0, -right] {
+            put16(&mut glyf, dx as u16);
+        }
+        for dy in [DESCENDER, 0, ASCENDER - DESCENDER, 0] {
+            put16(&mut glyf, dy as u16);
+        }
+        while glyf.len() % 4 != 0 {
+            glyf.push(0);
+        }
+        loca.push(glyf.len() as u32);
+        put16(&mut hmtx, advance);
+        put16(&mut hmtx, 0);
+    }
+    let loca: Vec<u8> = loca.iter().flat_map(|o| o.to_be_bytes()).collect();
+
+    let mut head = Vec::new();
+    put32(&mut head, 0x0001_0000);
+    put32(&mut head, 0x0001_0000);
+    put32(&mut head, 0);
+    put32(&mut head, 0x5f0f_3cf5);
+    put16(&mut head, 0x000b);
+    put16(&mut head, UNITS_PER_EM);
+    head.extend_from_slice(&[0; 16]);
+    for v in [0, DESCENDER, max_advance as i16, ASCENDER] {
+        put16(&mut head, v as u16);
+    }
+    put16(&mut head, 0);
+    put16(&mut head, 8);
+    put16(&mut head, 2);
+    put16(&mut head, 1);
+    put16(&mut head, 0);
+
+    let mut hhea = Vec::new();
+    put32(&mut hhea, 0x0001_0000);
+    for v in [ASCENDER, DESCENDER, LINE_GAP] {
+        put16(&mut hhea, v as u16);
+    }
+    put16(&mut hhea, max_advance);
+    put16(&mut hhea, 0);
+    put16(&mut hhea, 0);
+    put16(&mut hhea, max_advance);
+    put16(&mut hhea, 1);
+    hhea.extend_from_slice(&[0; 12]);
+    put16(&mut hhea, 0);
+    put16(&mut hhea, count);
+
+    let mut maxp = Vec::new();
+    put32(&mut maxp, 0x0001_0000);
+    put16(&mut maxp, count);
+    put16(&mut maxp, 4);
+    put16(&mut maxp, 1);
+    put16(&mut maxp, 0);
+    put16(&mut maxp, 0);
+    put16(&mut maxp, 2);
+    maxp.extend_from_slice(&[0; 16]);
+
+    let first = glyphs.first().map_or(0, |(c, _)| *c as u16);
+    let last = glyphs.last().map_or(0, |(c, _)| *c as u16);
+    let average = if glyphs.is_empty() {
+        0
+    } else {
+        glyphs.iter().map(|(_, a)| u32::from(*a)).sum::<u32>() / glyphs.len() as u32
+    };
+    let mut os2 = Vec::new();
+    put16(&mut os2, 4);
+    put16(&mut os2, average as u16);
+    put16(&mut os2, 400);
+    put16(&mut os2, 5);
+    put16(&mut os2, 0);
+    os2.extend_from_slice(&[0; 22]);
+    os2.extend_from_slice(&[0; 10]);
+    os2.extend_from_slice(&[0; 16]);
+    os2.extend_from_slice(b"RHWP");
+    put16(&mut os2, 0x0040);
+    put16(&mut os2, first);
+    put16(&mut os2, last);
+    for v in [ASCENDER, DESCENDER, LINE_GAP] {
+        put16(&mut os2, v as u16);
+    }
+    put16(&mut os2, ASCENDER as u16);
+    put16(&mut os2, (-DESCENDER) as u16);
+    os2.extend_from_slice(&[0; 8]);
+    os2.extend_from_slice(&[0; 4]);
+    put16(&mut os2, 0);
+    put16(&mut os2, 0x20);
+    put16(&mut os2, 0);
+
+    let mut post = Vec::new();
+    put32(&mut post, 0x0003_0000);
+    post.extend_from_slice(&[0; 28]);
+
+    let mut cmap = Vec::new();
+    let segments = glyphs.len() + 1;
+    let search = 2 * (1usize << (usize::BITS - 1 - segments.leading_zeros()));
+    put16(&mut cmap, 0);
+    put16(&mut cmap, 1);
+    put16(&mut cmap, 3);
+    put16(&mut cmap, 1);
+    put32(&mut cmap, 12);
+    put16(&mut cmap, 4);
+    put16(&mut cmap, (16 + 8 * segments) as u16);
+    put16(&mut cmap, 0);
+    put16(&mut cmap, (2 * segments) as u16);
+    put16(&mut cmap, search as u16);
+    put16(&mut cmap, (search / 2).trailing_zeros() as u16);
+    put16(&mut cmap, (2 * segments - search) as u16);
+    let codes = glyphs.iter().map(|(c, _)| *c as u16).chain([0xffff]);
+    for code in codes.clone() {
+        put16(&mut cmap, code);
+    }
+    put16(&mut cmap, 0);
+    for code in codes.clone() {
+        put16(&mut cmap, code);
+    }
+    for (index, code) in codes.enumerate() {
+        let glyph = if code == 0xffff { 0 } else { index as u16 + 1 };
+        put16(&mut cmap, glyph.wrapping_sub(code));
+    }
+    for _ in 0..segments {
+        put16(&mut cmap, 0);
+    }
+
+    let records = [
+        (1, FAMILY),
+        (2, "Regular"),
+        (3, POSTSCRIPT_NAME),
+        (4, FAMILY),
+        (6, POSTSCRIPT_NAME),
+    ];
+    let mut strings = Vec::new();
+    let mut name = Vec::new();
+    put16(&mut name, 0);
+    put16(&mut name, records.len() as u16);
+    put16(&mut name, (6 + 12 * records.len()) as u16);
+    for (id, text) in records {
+        let offset = strings.len();
+        for unit in text.encode_utf16() {
+            put16(&mut strings, unit);
+        }
+        for v in [3, 1, 0x0409, id, (strings.len() - offset) as u16, offset as u16] {
+            put16(&mut name, v);
+        }
+    }
+    name.extend_from_slice(&strings);
+
+    let tables: [(&[u8; 4], Vec<u8>); 10] = [
+        (b"OS/2", os2),
+        (b"cmap", cmap),
+        (b"glyf", glyf),
+        (b"head", head),
+        (b"hhea", hhea),
+        (b"hmtx", hmtx),
+        (b"loca", loca),
+        (b"maxp", maxp),
+        (b"name", name),
+        (b"post", post),
+    ];
+    let mut font = Vec::new();
+    put32(&mut font, 0x0001_0000);
+    put16(&mut font, tables.len() as u16);
+    put16(&mut font, 128);
+    put16(&mut font, 3);
+    put16(&mut font, (16 * tables.len() - 128) as u16);
+    let mut offset = 12 + 16 * tables.len();
+    let mut head_offset = 0;
+    for (tag, data) in &tables {
+        if *tag == b"head" {
+            head_offset = offset;
+        }
+        font.extend_from_slice(*tag);
+        put32(&mut font, checksum(data));
+        put32(&mut font, offset as u32);
+        put32(&mut font, data.len() as u32);
+        offset += data.len().div_ceil(4) * 4;
+    }
+    for (_, data) in &tables {
+        font.extend_from_slice(data);
+        while font.len() % 4 != 0 {
+            font.push(0);
+        }
+    }
+    let adjustment = 0xb1b0_afbau32.wrapping_sub(checksum(&font));
+    font[head_offset + 8..head_offset + 12].copy_from_slice(&adjustment.to_be_bytes());
+    font
+}
+
+fn put16(out: &mut Vec<u8>, value: u16) {
+    out.extend_from_slice(&value.to_be_bytes());
+}
+
+fn put32(out: &mut Vec<u8>, value: u32) {
+    out.extend_from_slice(&value.to_be_bytes());
+}
+
+fn checksum(data: &[u8]) -> u32 {
+    data.chunks(4).fold(0u32, |sum, chunk| {
+        let mut word = [0u8; 4];
+        word[..chunk.len()].copy_from_slice(chunk);
+        sum.wrapping_add(u32::from_be_bytes(word))
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn face_maps_each_code_to_a_box_with_its_advance() {
+        let bytes = build(&[('\u{e034}', 512), ('A', 768), ('\u{e05c}', 1024), ('A', 1)]);
+        let face = ttf_parser::Face::parse(&bytes, 0).expect("generated face parses");
+        assert_eq!(face.units_per_em(), 1024);
+        assert_eq!(face.number_of_glyphs(), 4);
+        assert_eq!(face.ascender(), 820);
+        assert_eq!(face.descender(), -204);
+        let family = face
+            .names()
+            .into_iter()
+            .find(|name| name.name_id == ttf_parser::name_id::FAMILY)
+            .and_then(|name| name.to_string());
+        assert_eq!(family.as_deref(), Some(FAMILY));
+        let advance = |c: char| {
+            let glyph = face.glyph_index(c)?;
+            Some((glyph.0, face.glyph_hor_advance(glyph)?))
+        };
+        assert_eq!(advance('A'), Some((1, 768)));
+        assert_eq!(advance('\u{e034}'), Some((2, 512)));
+        assert_eq!(advance('\u{e05c}'), Some((3, 1024)));
+        assert_eq!(advance('B'), None);
+        let rect = face
+            .glyph_bounding_box(ttf_parser::GlyphId(3))
+            .expect("box glyph");
+        assert_eq!((rect.x_min, rect.y_min, rect.x_max, rect.y_max), (0, -204, 1024, 820));
+    }
+
+    #[test]
+    fn hyhwpeq_advances_hold_the_face_hmtx() {
+        let advances = hyhwpeq_advances();
+        let get = |c: char| advances.iter().find(|(code, _)| *code == c).map(|(_, a)| *a);
+        assert_eq!(get('\u{e034}'), Some(512));
+        assert_eq!(get('\u{e0e5}'), Some(541));
+        assert_eq!(get('\u{e000}'), Some(768));
+        assert_eq!(get('A'), Some(768));
+        assert_eq!(get('\u{e046}'), Some(774));
+        assert_eq!(get('\u{e042}'), Some(853));
+        assert_eq!(get('\u{e06d}'), Some(512));
+        assert_eq!(get('\u{e05c}'), Some(1024));
+        assert_eq!(get('\u{e04b}'), Some(594));
+        assert_eq!(get('\u{e07b}'), Some(506));
+        assert_eq!(hyhwpeq_advance('\u{e0fc}'), Some(585));
+        assert_eq!(hyhwpeq_advance('\u{e078}'), Some(506));
+        assert_eq!(hyhwpeq_advance('\u{e09d}'), None);
+    }
+}
