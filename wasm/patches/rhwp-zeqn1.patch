+        // 1: no installed face draws it, so it is left to the decoder.
+        let digit = text('\u{e034}', hyhwpeq);
+        // Greek alpha has no HyhwpEQ advance here; another face is not touched.
+        let greek = text('\u{e09d}', hyhwpeq);
+        let other = text('\u{e0e5}', "font-family=\"Other\"");
+        let svg = format!("<svg xmlns=\"http://www.w3.org/2000/svg\">{italic_a}{digit}{greek}{other}</svg>");
