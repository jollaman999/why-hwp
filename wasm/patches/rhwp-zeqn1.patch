+++ b/src/renderer/equation/hancom_glyphs.rs
@@ -196,0 +197,33 @@ pub(crate) fn semantic_fallback_glyph(family: &str, encoded: char) -> Option<(ch
+/// The HYhwpEQ hmtx advance (UPM 1024) of every code `glyph` paints with the
+/// face. The table's advances are the hmtx ones except the legacy percent,
+/// whose one-em HFT slot stands in for its hmtx 853/1024.
+pub(crate) fn face_advances() -> &'static std::collections::BTreeMap<char, u16> {
+    use std::collections::BTreeMap;
+    use std::sync::OnceLock;
+    static ADVANCES: OnceLock<BTreeMap<char, u16>> = OnceLock::new();
+    ADVANCES.get_or_init(|| {
+        let mut map = BTreeMap::new();
+        let characters = ('A'..='Z')
+            .chain('a'..='z')
+            .chain('0'..='9')
+            .chain("+-=:<>×÷≤≥∴∵,()∏'△․%".chars());
+        for character in characters {
+            for role in [
+                Role::Variable { italic: false },
+                Role::Variable { italic: true },
+                Role::Number,
+                Role::Operator,
+                Role::SmallOperator,
+                Role::QuotedLiteral,
+                Role::LegacyLiteral,
+            ] {
+                if let Some((code, advance)) = glyph(character, role) {
+                    map.entry(code).or_insert(advance);
+                }
+            }
+        }
+        map.insert('\u{e042}', 853);
+        map
+    })
+}
