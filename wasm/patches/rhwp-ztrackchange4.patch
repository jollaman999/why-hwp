# rhwp memo shape for why-hwp: keep secPr@memoShapeIDRef in an HWPX to HWP save.
# Base: rhwp 7213ed1f9 after the source edits in wasm/patch-rhwp.sh and
# wasm/patches/rhwp-layout.patch to rhwp-trackchange3.patch; apply this after
# rhwp-trackchange3.patch.
# Zero-context diff (apply with git apply --unidiff-zero).
#
# - The secd CTRL_HEADER tail that an HWPX to HWP save builds was all zero, so
#   the section lost its memo shape (offset 30 read 0, "none"). It now carries
#   SectionDef::memo_shape_id at offset 30 (tail offset 6), where Hancom Office
#   2024 writes it when it saves the same HWPX as HWP (t2.hwpx and an HWPX of
#   rhwp sample issue5169: offset 30 = 1). rhwp-trackchange2.patch reads the
#   HWP side from the same place.
diff --git a/src/document_core/converters/hwpx_to_hwp.rs b/src/document_core/converters/hwpx_to_hwp.rs
--- a/src/document_core/converters/hwpx_to_hwp.rs
+++ b/src/document_core/converters/hwpx_to_hwp.rs
@@ -2392,0 +2393,3 @@
+    // why-hwp: secd offset 30 (tail offset 6) holds secPr@memoShapeIDRef, as
+    // Hancom Office 2024 writes it when it saves an HWPX as HWP.
+    extra[6..8].copy_from_slice(&section_def.memo_shape_id.to_le_bytes());
@@ -4808,0 +4812,23 @@
+    }
+
+    /// why-hwp: secPr@memoShapeIDRef goes to secd offset 30 (tail offset 6), where
+    /// Hancom Office 2024 writes it (rhwp sample issue5169 and t2 saved as HWP).
+    #[test]
+    fn section_def_tail_carries_memo_shape_id() {
+        for (version, len) in [(hwp_version(5, 1, 0, 0), 19), (hwp_version(5, 0, 3, 0), 10)] {
+            let mut section_def = SectionDef {
+                memo_shape_id: 2,
+                ..Default::default()
+            };
+            let mut report = AdapterReport::new();
+            materialize_section_def_ctrl_tail(
+                &mut section_def,
+                &version,
+                &mut report,
+                &crate::storage::Unbounded,
+            )
+            .unwrap();
+            let mut expected = vec![0u8; len];
+            expected[6] = 2;
+            assert_eq!(section_def.raw_ctrl_extra, expected);
+        }
