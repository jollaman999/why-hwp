# rhwp glyph width fix for why-hwp, measured against Hangul 2024 output.
# Base: rhwp 981ce66b4 (v0.9.1) after the source edits in wasm/patch-rhwp.sh and every
# earlier wasm/patches/*.patch in name order; apply this after
# rhwp-trackchange3.patch.
# Zero-context diff (apply with git apply --unidiff-zero).
#
# - svg.rs: a single character whose advance comes from rhwp's table of
#   original HFT program glyph widths (the /Widths of Hangul's Type 3 fonts) is
#   drawn fitted to that advance with textLength, as ASCII letters and digits
#   are. It was drawn with the substitute font's own width, so its glyph box in
#   the PDF ended short: the 필기 (Pilgi) U+2019 advances 0.5 em, Malgun Gothic
#   draws it 0.23 em wide.
# - svg/tests.rs covers it.
diff --git a/src/renderer/svg.rs b/src/renderer/svg.rs
index c1f795def2..e1cbd5401e 100644
--- a/src/renderer/svg.rs
+++ b/src/renderer/svg.rs
@@ -4575 +4575 @@ fn svg_cluster_text_length_attrs(
-        fit_narrow_hangul,
+        fit_narrow_hangul || is_original_program_glyph(cluster_str, style),
@@ -4578,0 +4579,32 @@ fn svg_cluster_text_length_attrs(
+/// 원본 HFT 프로그램의 글리프 폭(한컴 Print Type3 /Widths)으로 잰 낱글자인가.
+///
+/// 이 글자는 대체 글꼴로 그려지므로, 맞추지 않으면 PDF 글리프 상자가 원본 폭이 아니라
+/// 대체 글꼴의 제 폭이 된다. fdi-2025q2 3쪽 필기 `’`: 원본 0.5em, 맑은 고딕 0.23em.
+fn is_original_program_glyph(cluster_str: &str, style: &TextStyle) -> bool {
+    let mut chars = cluster_str.chars();
+    let (Some(ch), None) = (chars.next(), chars.next()) else {
+        return false;
+    };
+    let decision = super::layout::char_width_decision(&[ch], &[1], 0, style, true);
+    if decision.width_source != "measuredOriginalGlyph" {
+        return false;
+    }
+    let primary = style
+        .font_family
+        .split(',')
+        .next()
+        .unwrap_or("")
+        .trim()
+        .trim_matches(['\'', '"']);
+    style
+        .original_glyph_metric_family
+        .as_deref()
+        .map(String::as_str)
+        .into_iter()
+        .chain(std::iter::once(primary))
+        .any(|face| {
+            super::font_metrics_data::original_glyph_advance_em(face, style.bold, style.italic, ch)
+                .is_some()
+        })
+}
+
diff --git a/src/renderer/svg/tests.rs b/src/renderer/svg/tests.rs
index bc731ec40c..9933d3d40c 100644
--- a/src/renderer/svg/tests.rs
+++ b/src/renderer/svg/tests.rs
@@ -1563,0 +1564,37 @@ fn test_svg_hidden_middle_dot_text_is_fitted_to_glyph_advance() {
+#[test]
+fn test_svg_original_program_glyph_is_fitted_to_its_advance() {
+    // fdi-2025q2 3쪽 제목: 필기 16pt, 장평 80%, 자간 -8%.
+    let font_size = 1600.0 / 75.0;
+    let style = |face: &str| TextStyle {
+        font_family: face.to_string(),
+        font_size,
+        ratio: 0.8,
+        letter_spacing: -0.08 * font_size,
+        source_font_is_hft: true,
+        original_glyph_metric_family: Some(std::sync::Arc::new(face.to_string())),
+        ..Default::default()
+    };
+    let text_length = |style: &TextStyle, ch: char| -> Option<f64> {
+        let mut renderer = SvgRenderer::new();
+        renderer.begin_page(800.0, 600.0);
+        renderer.draw_text(&format!("가{ch}나"), 10.0, 20.0, style);
+        let output = renderer.output();
+        let close = output
+            .find(&format!(">{ch}</text>"))
+            .unwrap_or_else(|| panic!("{ch:?} text: {output}"));
+        let tag = &output[output[..close].rfind("<text").unwrap()..close];
+        let at = tag.find(" textLength=\"")? + " textLength=\"".len();
+        let end = tag[at..].find('"').unwrap();
+        Some(tag[at..at + end].parse().unwrap())
+    };
+
+    // 원본 0.5em 을 장평으로 나누기 전 폭으로 받는다. 자간은 글리프 폭에 넣지 않는다.
+    let pilgi = style("필기");
+    let fitted = text_length(&pilgi, '\u{2019}').expect("필기 U+2019 textLength");
+    assert!((fitted - 0.5 * font_size).abs() < 0.05, "{fitted}");
+
+    // 원본 폭을 확인하지 않은 글자와 글꼴은 대체 글꼴의 제 폭으로 둔다.
+    assert_eq!(text_length(&pilgi, '\u{2018}'), None);
+    assert_eq!(text_length(&style("맑은 고딕"), '\u{2019}'), None);
+}
+
